              {
                "box": {
                  "id": "obj-3",
                  "maxclass": "codebox",
                  "code": "// VINK·LOOP: recursive feedback network (ring modulator + filters + tape saturation + delay in a closed loop), stereo.\n// Generated by build_vink.py - edit there, not here.\nParam seedlvl(0.5, min=0, max=1);          // how much of the track audio seeds the loop\nParam nfloor(0.25, min=0, max=1);          // noise floor injected into the loop (self-start)\nParam fbk(1.3, min=0, max=1.5);            // loop gain; ring mod + filters lose energy, so the loop only holds from about 1.2 (measured, see test)\nParam ringd(0.5, min=0, max=1);            // ring modulator depth\nParam cfreq(55, min=0.5, max=2000);        // carrier oscillator Hz\nParam cmode(0, min=0, max=1);              // 0 oscillator, 1 cross-feed (carrier = second delay tap)\nParam hpf(80, min=20, max=400);\nParam lpf(8000, min=1000, max=16000);\nParam satur(0.4, min=0, max=1);\nParam dtime(180, min=20, max=500);         // ms\nParam wow(0.25, min=0, max=1);\nParam spread(0.3, min=0, max=1);\nParam level(0.5, min=0, max=1);\nParam wetmix(1, min=0, max=1);\nParam burst(0, min=0, max=1);              // 1 = inject a noise burst (button holds it ~120 ms)\n\nHistory phAL(0); History phBL(0); History nzL(0); History cphL(0); History wL(0);\nHistory hs1L(0); History hs2L(0); History ls1L(0); History ls2L(0);\nData dbL(131072);\nHistory phAR(0); History phBR(0); History nzR(0); History cphR(0); History wR(0);\nHistory hs1R(0); History hs2R(0); History ls1R(0); History ls2R(0);\nData dbR(131072);\n\n// ---- parameters, clamped so that unset/zero values can never produce inf or NaN ----\nsl = max(0, min(1, seedlvl));\nnzp = max(0, min(1, nfloor));\nnf = nzp * nzp * 0.05;\nfbk2 = max(0, min(1.5, fbk));\nrd = max(0, min(1, ringd));\ncf = max(0.5, min(2000, cfreq));\ncrs = max(0, min(1, cmode));\nrde = rd;\nif (crs > 0.5) {\n    rde = min(rd, 0.85);   // pure product with its own delayed tap would die; the cross-feed ring is capped\n}\nrnorm = 1 / sqrt((1 - rde) * (1 - rde) + 0.5 * rde * rde);   // tone: (1-rde) stays, rde/2 per sideband -> unit power\nhpa = 1 - exp(-6.283185307179586 * max(20, min(400, hpf)) / samplerate);\nlpa = 1 - exp(-6.283185307179586 * max(1000, min(16000, lpf)) / samplerate);\ndrv = 1 + 5 * max(0, min(1, satur));\ntau = max(20, min(500, dtime)) * 0.001 * samplerate;\nwowd = max(0, min(1, wow));\nspr = max(0, min(1, spread));\nlvl = max(0, min(1, level));\nwmx = max(0, min(1, wetmix));\nbg = max(0, min(1, burst));\n\n// ================= channel L =================\n// wow / flutter / random drift on the delay time\nphAL = phAL + 0.45 / samplerate; phAL = phAL - floor(phAL);\nphBL = phBL + 5.3 / samplerate;  phBL = phBL - floor(phBL);\nnzL = nzL + 0.0005 * (noise() - nzL);\nwmL = wowd * (0.02 * sin(6.283185307179586 * phAL) + 0.006 * sin(6.283185307179586 * phBL) + 0.09 * nzL);\ntdL = tau * 1 * (1 + wmL);\ntdL = max(64, min(131072 - 8, tdL));\n// two taps of the delay line (read before this sample is written)\nrpL = wL - tdL;\nif (rpL < 0) { rpL = rpL + 131072; }\ni0L = floor(rpL); frL = rpL - i0L;\nxL = peek(dbL, mod(i0L, 131072)) * (1 - frL) + peek(dbL, mod(i0L + 1, 131072)) * frL;\nrqL = wL - tdL * 0.618;\nif (rqL < 0) { rqL = rqL + 131072; }\nj0L = floor(rqL); fqL = rqL - j0L;\nx2L = peek(dbL, mod(j0L, 131072)) * (1 - fqL) + peek(dbL, mod(j0L + 1, 131072)) * fqL;\n// carrier: sine oscillator, or the cross-feed tap\nif (crs > 0.5) {\n    carL = 0.15 + 0.85 * tanh(3 * drv * x2L);   // 0.15 = leak of an unbalanced ring modulator, lets the loop start\n} else {\n    cphL = cphL + cf * 1 / samplerate; cphL = cphL - floor(cphL);\n    carL = sin(6.283185307179586 * cphL);\n}\n// mixer / hub: seed + noise floor + burst + feedback\nhubL = in1 * sl + fbk2 * xL + nf * noise() + bg * 0.3 * noise() + 0.0000000001 * noise();\n// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point\nrmoL = hubL * (1 - rde + rde * carL) * rnorm;\n// 2-pole high-pass, 2-pole low-pass\nhs1L = hs1L + hpa * (rmoL - hs1L); vvL = rmoL - hs1L;\nhs2L = hs2L + hpa * (vvL - hs2L);  vvL = vvL - hs2L;\nls1L = ls1L + lpa * (vvL - ls1L);\nls2L = ls2L + lpa * (ls1L - ls2L);\n// tape saturation: soft limiter with unity small-signal gain, peak 1/drive\nsvL = tanh(drv * ls2L) / drv;\npoke(dbL, svL, wL);\nwL = mod(wL + 1, 131072);\n// output tap = delay output; x <= 1/drive, so wet <= level\nout1 = in1 * (1 - wmx) + xL * drv * lvl * wmx;\n\n// ================= channel R =================\n// wow / flutter / random drift on the delay time\nphAR = phAR + 0.45 / samplerate; phAR = phAR - floor(phAR);\nphBR = phBR + 5.3 / samplerate;  phBR = phBR - floor(phBR);\nnzR = nzR + 0.0005 * (noise() - nzR);\nwmR = wowd * (0.02 * sin(6.283185307179586 * phAR) + 0.006 * sin(6.283185307179586 * phBR) + 0.09 * nzR);\ntdR = tau * (1 + 0.07 * spr) * (1 + wmR);\ntdR = max(64, min(131072 - 8, tdR));\n// two taps of the delay line (read before this sample is written)\nrpR = wR - tdR;\nif (rpR < 0) { rpR = rpR + 131072; }\ni0R = floor(rpR); frR = rpR - i0R;\nxR = peek(dbR, mod(i0R, 131072)) * (1 - frR) + peek(dbR, mod(i0R + 1, 131072)) * frR;\nrqR = wR - tdR * 0.618;\nif (rqR < 0) { rqR = rqR + 131072; }\nj0R = floor(rqR); fqR = rqR - j0R;\nx2R = peek(dbR, mod(j0R, 131072)) * (1 - fqR) + peek(dbR, mod(j0R + 1, 131072)) * fqR;\n// carrier: sine oscillator, or the cross-feed tap\nif (crs > 0.5) {\n    carR = 0.15 + 0.85 * tanh(3 * drv * x2R);   // 0.15 = leak of an unbalanced ring modulator, lets the loop start\n} else {\n    cphR = cphR + cf * (1 + 0.013 * spr) / samplerate; cphR = cphR - floor(cphR);\n    carR = sin(6.283185307179586 * cphR);\n}\n// mixer / hub: seed + noise floor + burst + feedback\nhubR = in2 * sl + fbk2 * xR + nf * noise() + bg * 0.3 * noise() + 0.0000000001 * noise();\n// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point\nrmoR = hubR * (1 - rde + rde * carR) * rnorm;\n// 2-pole high-pass, 2-pole low-pass\nhs1R = hs1R + hpa * (rmoR - hs1R); vvR = rmoR - hs1R;\nhs2R = hs2R + hpa * (vvR - hs2R);  vvR = vvR - hs2R;\nls1R = ls1R + lpa * (vvR - ls1R);\nls2R = ls2R + lpa * (ls1R - ls2R);\n// tape saturation: soft limiter with unity small-signal gain, peak 1/drive\nsvR = tanh(drv * ls2R) / drv;\npoke(dbR, svR, wR);\nwR = mod(wR + 1, 131072);\n// output tap = delay output; x <= 1/drive, so wet <= level\nout2 = in2 * (1 - wmx) + xR * drv * lvl * wmx;\n",
                  "numinlets": 2,
                  "numoutlets": 2,
                  "outlettype": [
                    "",
                    ""
                  ],
