              {
                "box": {
                  "id": "obj-3",
                  "maxclass": "codebox",
                  "code": "// VINK-LOOP: recursive feedback network (ring modulator + filters + tape saturation + delay in a closed loop), stereo.\n// Generated by build_vink.py - edit there, not here.\nParam seedlvl(0.5, min=0, max=1);          // how much of the track audio seeds the loop\nParam nfloor(0.25, min=0, max=1);          // noise floor injected into the loop (self-start)\nParam fbk(0.9, min=0, max=1.5);            // loop gain; the loop holds from about 0.8 at the default resonance (higher resonance: lower; measured, see test)\nParam ringd(0.5, min=0, max=1);            // ring modulator depth\nParam cfreq(55, min=0.5, max=2000);        // carrier oscillator Hz\nParam cwave(0, min=0, max=7);              // carrier: 0 sine, 1 triangle, 2 saw, 3 square, 4 sample-and-hold, 5 smooth random, 6 noise, 7 cross-feed (2nd delay tap)\nParam hpf(80, min=20, max=400);\nParam lpf(8000, min=1000, max=16000);\nParam fdrive(0, min=0, max=1);             // drive into the filters (0 = off)\nParam fxtype(0, min=0, max=3);             // FX slot between filter and tape: 0 off, 1 wavefolder, 2 spring reverb, 3 bitcrusher\nParam fxfold(0.6, min=0, max=1);           // wavefolder amount\nParam fxspring(0.6, min=0, max=1);         // spring reverb decay, 0.2 s ... 3 s (T60)\nParam fxbits(0.88, min=0, max=1);          // bitcrusher: 0 = 16 bit ... 1 = 2 bit\nParam fxrate(0.8, min=0, max=1);           // bitcrusher: sample-rate reduction, 0 = none ... 1 = 1/32\nParam fxmix(1, min=0, max=1);              // wet/dry of the FX slot\nParam ftype(0, min=0, max=3);              // filter character: 0 clean 12 dB, 1 ladder 24 dB, 2 MS-20 style 12 dB, 3 soft 6 dB\nParam reso(0.2, min=0, max=1);              // resonance of both loop filters (low-pass full, high-pass about half)\nParam satur(0.4, min=0, max=1);\nParam dtype(0, min=0, max=3);              // delay type: 0 tape (wow/flutter), 1 digital (clean), 2 BBD (dark + hiss), 3 ping-pong (L and R feed each other)\nParam dtime(180, min=20, max=500);         // ms\nParam wow(0.25, min=0, max=1);\nParam spread(0.3, min=0, max=1);\nParam width(1, min=0, max=1);              // stereo width of the result: 0 mono, 1 as is (mid/side)\nParam level(0.5, min=0, max=1);\nParam wetmix(1, min=0, max=1);\nParam burst(0, min=0, max=1);              // 1 = inject a noise burst (button holds it ~120 ms)\nParam clear(0, min=0, max=1);              // 1 = RESET: silence the loop and zero delay + filter memory (button holds it ~750 ms)\n\nHistory phAL(0); History phBL(0); History nzL(0); History cphL(0); History wL(0); History tdgL(0);\nHistory shL(0); History saL(0); History sbL(0);\nHistory hq1L(0); History hq2L(0); History lq1L(0); History lq2L(0); History bb1L(0); History bb2L(0); History xpL(0);\nHistory hs1L(0); History hs2L(0); History hs3L(0); History hs4L(0); History hm1L(0); History hm2L(0); History hmbL(0); History hsoL(0);\nHistory ls1L(0); History ls2L(0); History ls3L(0); History ls4L(0); History lm1L(0); History lm2L(0); History lmbL(0); History lsoL(0);\nData dbL(131072);\nHistory bhdL(0); History bphL(0);\nHistory sw1L(0); History sl1L(0); Data sd1L(16384);\nHistory ss10L(0); History ss11L(0); History ss12L(0); History ss13L(0); History ss14L(0); History ss15L(0); History ss16L(0); History ss17L(0); History ss18L(0); History ss19L(0); History ss110L(0); History ss111L(0); History ss112L(0); History ss113L(0); History ss114L(0); History ss115L(0); History ss116L(0); History ss117L(0); History ss118L(0); History ss119L(0); History ss120L(0); History ss121L(0); History ss122L(0); History ss123L(0); \nHistory sw2L(0); History sl2L(0); Data sd2L(16384);\nHistory ss20L(0); History ss21L(0); History ss22L(0); History ss23L(0); History ss24L(0); History ss25L(0); History ss26L(0); History ss27L(0); History ss28L(0); History ss29L(0); History ss210L(0); History ss211L(0); History ss212L(0); History ss213L(0); History ss214L(0); History ss215L(0); History ss216L(0); History ss217L(0); History ss218L(0); History ss219L(0); History ss220L(0); History ss221L(0); History ss222L(0); History ss223L(0); \nHistory phAR(0); History phBR(0); History nzR(0); History cphR(0); History wR(0); History tdgR(0);\nHistory shR(0); History saR(0); History sbR(0);\nHistory hq1R(0); History hq2R(0); History lq1R(0); History lq2R(0); History bb1R(0); History bb2R(0); History xpR(0);\nHistory hs1R(0); History hs2R(0); History hs3R(0); History hs4R(0); History hm1R(0); History hm2R(0); History hmbR(0); History hsoR(0);\nHistory ls1R(0); History ls2R(0); History ls3R(0); History ls4R(0); History lm1R(0); History lm2R(0); History lmbR(0); History lsoR(0);\nData dbR(131072);\nHistory bhdR(0); History bphR(0);\nHistory sw1R(0); History sl1R(0); Data sd1R(16384);\nHistory ss10R(0); History ss11R(0); History ss12R(0); History ss13R(0); History ss14R(0); History ss15R(0); History ss16R(0); History ss17R(0); History ss18R(0); History ss19R(0); History ss110R(0); History ss111R(0); History ss112R(0); History ss113R(0); History ss114R(0); History ss115R(0); History ss116R(0); History ss117R(0); History ss118R(0); History ss119R(0); History ss120R(0); History ss121R(0); History ss122R(0); History ss123R(0); \nHistory sw2R(0); History sl2R(0); Data sd2R(16384);\nHistory ss20R(0); History ss21R(0); History ss22R(0); History ss23R(0); History ss24R(0); History ss25R(0); History ss26R(0); History ss27R(0); History ss28R(0); History ss29R(0); History ss210R(0); History ss211R(0); History ss212R(0); History ss213R(0); History ss214R(0); History ss215R(0); History ss216R(0); History ss217R(0); History ss218R(0); History ss219R(0); History ss220R(0); History ss221R(0); History ss222R(0); History ss223R(0); \n\n// ---- parameters, clamped so that unset/zero values can never produce inf or NaN ----\nsl = max(0, min(1, seedlvl));\nnzp = max(0, min(1, nfloor));\nnf = nzp * nzp * 0.05;\nfbk2 = max(0, min(1.5, fbk));\nrd = max(0, min(1, ringd));\ncf = max(0.5, min(2000, cfreq));\nwv = max(0, min(7, floor(cwave + 0.5)));\nk0 = wv < 0.5;\nk1 = (wv > 0.5) * (wv < 1.5);\nk2 = (wv > 1.5) * (wv < 2.5);\nk3 = (wv > 2.5) * (wv < 3.5);\nk4 = (wv > 3.5) * (wv < 4.5);\nk5 = (wv > 4.5) * (wv < 5.5);\nk6 = (wv > 5.5) * (wv < 6.5);\nk7 = wv > 6.5;\n// mean square of each carrier (for the power normalisation of the ring modulator)\ncpow = 0.5 * k0 + 0.3333 * k1 + 0.3333 * k2 + 1 * k3 + 0.3333 * k4 + 0.2 * k5 + 0.3333 * k6 + 0.5 * k7;\nrde = rd * (1 - k7) + min(rd, 0.85) * k7;   // cross-feed: pure product with its own delayed tap would die, so RING is capped there\nrnorm = 1 / sqrt((1 - rde) * (1 - rde) + cpow * rde * rde);\nfcH = max(20, min(400, hpf));\nfcL = min(max(1000, min(16000, lpf)), 0.45 * samplerate);\nrs = max(0, min(1, reso));\nkL = 1 / (0.707 + rs * rs * 10);               // damping = 1/Q: Q 0.707 (no resonance) ... 10.7\nkH = 1 / (0.707 + rs * rs * 4);\ngH = tan(3.141592653589793 * fcH / samplerate);\ngL = tan(3.141592653589793 * fcL / samplerate);\nhdn = 1 / (1 + gH * (gH + kH));\nldn = 1 / (1 + gL * (gL + kL));\nqH = 1 / (1 + gH); GH = gH * qH; qH2 = qH * qH; qH3 = qH2 * qH; qH4 = qH3 * qH;\nqL = 1 / (1 + gL); GL = gL * qL; GL2 = GL * GL; GL3 = GL2 * GL; GL4 = GL3 * GL;\nkLadL = 3.8 * rs;                                // ladder resonance feedback (self-oscillation would be 4)\nkLadH = 3.0 * rs;\ncmpL = 1 + 0.75 * kLadL;                         // a real ladder loses level as the resonance rises; 75 % of that is made up so the loop can still hold\ncmpH = 1 + 0.75 * kLadH;\nkMsL = 1 / (0.707 + rs * rs * 20);               // MS-20 style: Q up to ~21 (low-pass), ~9 (high-pass), damped by its own level\nkMsH = 1 / (0.707 + rs * rs * 8);\nfdr = max(0, min(1, fdrive));\nfdg = 1 + 4 * fdr;\nftn = tanh(fdg);\nwdt = max(0, min(1, width));\nex = max(0, min(3, floor(fxtype + 0.5)));\ne0 = ex < 0.5;\ne1 = (ex > 0.5) * (ex < 1.5);\ne2 = (ex > 1.5) * (ex < 2.5);\ne3 = ex > 2.5;\nbqv = pow(2, 15 - 14 * max(0, min(1, fxbits)));   // quantiser steps per unit: 32768 (16 bit) ... 2 (2 bit)\nbfac = 1 + 31 * max(0, min(1, fxrate)) * max(0, min(1, fxrate));\nfa = 1 + 14 * max(0, min(1, fxfold)) * max(0, min(1, fxfold));\nspv = max(0, min(1, fxspring));\nspt = 0.2 * pow(15, spv);                          // spring T60 in seconds\nsfb1 = pow(10, -3 * 0.0313 / spt);                 // feedback per round trip so that the tail falls 60 dB in spt\nsfb2 = pow(10, -3 * 0.0437 / spt);\nsnr1 = sqrt(1 - sfb1 * sfb1);                      // unit average power gain per spring\nsnr2 = sqrt(1 - sfb2 * sfb2);\nsdt1 = 0.0313 * samplerate;\nsdt2 = 0.0437 * samplerate;\nsdmp = 1 - exp(-6.283185307179586 * 3500 / samplerate);   // springs are dark\nfxm = max(0, min(1, fxmix));\nfv = max(0, min(3, floor(ftype + 0.5)));\nf0 = fv < 0.5;\nf1 = (fv > 0.5) * (fv < 1.5);\nf2 = (fv > 1.5) * (fv < 2.5);\nf3 = fv > 2.5;\nbba = 1 - exp(-6.283185307179586 * 3500 / samplerate);\ndv = max(0, min(3, floor(dtype + 0.5)));\nkT = dv < 0.5;\nkD = (dv > 0.5) * (dv < 1.5);\nkB = (dv > 1.5) * (dv < 2.5);\npp = dv > 2.5;\nwowe = max(0, min(1, wow)) * (kT + 0.5 * kB);   // wow/flutter: tape full, BBD half, digital and ping-pong none\ndrv = 1 + 5 * max(0, min(1, satur));\ntau = max(20, min(500, dtime)) * 0.001 * samplerate;\ntdk = 1 / (0.08 * samplerate);                     // delay-time glide: 80 ms one-pole ...\ntdlim = 0.4;                                       // ... limited to 0.4 samples per sample (read speed 0.6x ... 1.4x)\nspr = max(0, min(1, spread));\nlvl = max(0, min(1, level));\nwmx = max(0, min(1, wetmix));\nbg = max(0, min(1, burst));\nkeep = 1 - max(0, min(1, clear));\n\n// ================= channel L =================\n// wow / flutter / random drift on the delay time\nphAL = phAL + 0.45 / samplerate; phAL = phAL - floor(phAL);\nphBL = phBL + 5.3 / samplerate;  phBL = phBL - floor(phBL);\nnzL = nzL + 0.0005 * (noise() - nzL);\nwmL = wowe * (0.02 * sin(6.283185307179586 * phAL) + 0.006 * sin(6.283185307179586 * phBL) + 0.09 * nzL);\ntdL = tau * 1 * (1 + wmL);\ntdL = max(64, min(131072 - 8, tdL));\n// the read position glides to the wanted delay instead of jumping (a jump is a click): one-pole (80 ms) with a speed limit of tdlim samples per sample,\n// so turning DELAY, SPRD or switching the delay type bends the pitch of the repeats like a tape echo instead of clicking\ntdiL = tdgL < 1;\ntdgL = tdgL * (1 - tdiL) + tdL * tdiL;\ntdgL = tdgL + max(0 - tdlim, min(tdlim, (tdL - tdgL) * tdk));\n// two taps of the delay line (read before this sample is written); RESET (keep = 0) silences them at once\nrpL = wL - tdgL;\nif (rpL < 0) { rpL = rpL + 131072; }\ni0L = floor(rpL); frL = rpL - i0L;\nxL = (peek(dbL, mod(i0L, 131072)) * (1 - frL) + peek(dbL, mod(i0L + 1, 131072)) * frL) * keep;\nrqL = wL - tdgL * 0.618;\nif (rqL < 0) { rqL = rqL + 131072; }\nj0L = floor(rqL); fqL = rqL - j0L;\nx2L = (peek(dbL, mod(j0L, 131072)) * (1 - fqL) + peek(dbL, mod(j0L + 1, 131072)) * fqL) * keep;\n// carrier: one phase, all waveforms computed, selected by the weights k0..k7 (no if-blocks: GenExpr scoping)\npoL = cphL;\ncphL = cphL + cf * 1 / samplerate; cphL = cphL - floor(cphL);\nwrL = cphL < poL;                                  // 1 on the sample where the phase wraps\nshL = shL + wrL * (noise() - shL);               // sample & hold: new random value at each wrap\nsaL = saL + wrL * (sbL - saL);                 // smooth random: glide from the old to the new value\nsbL = sbL + wrL * (noise() - sbL);\ncSL = sin(6.283185307179586 * cphL);\ncTL = 1 - 4 * abs(cphL - 0.5);\ncWL = 2 * cphL - 1;\ncQL = 1 - 2 * (cphL > 0.5);\ncML = saL + (sbL - saL) * cphL * cphL * (3 - 2 * cphL);\ncXL = 0.15 + 0.85 * tanh(3 * drv * x2L);            // cross-feed; 0.15 = leak of an unbalanced ring modulator, lets the loop start\ncarL = k0 * cSL + k1 * cTL + k2 * cWL + k3 * cQL + k4 * shL + k5 * cML + k6 * noise() + k7 * cXL;\n// delay type PING-PONG: each loop is fed by a mix of its own delay output and the other channel's (pp = 0 -> independent loops)\nxoL = xL * (1 - pp) + xpR * pp;\n// mixer / hub: seed + noise floor + burst + feedback\nhubL = (in1 * sl + fbk2 * xoL + nf * noise() + bg * 0.3 * noise() + 0.00000000000000000001 * noise()) * keep;   // 1e-20: keeps the filter states away from denormals\n// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point\nrmoL = hubL * (1 - rde + rde * carL) * rnorm;\n// filter drive: saturates the signal going into the filters (0 = bypass, exact); small-signal gain rises with the drive\nrmfL = rmoL * (1 - fdr) + fdr * tanh(fdg * rmoL) / ftn;\n// ---------------- filter models: all four run in parallel on the same signal and the selected one is used, so switching never clicks.\n// High-pass first (input: ring modulator output), then low-pass (input: the selected high-pass). All states are cleared by RESET.\n// 0 CLEAN, high-pass: TPT state-variable filter, 12 dB/oct\nhvL = (rmfL - (kH + gH) * hq1L - hq2L) * hdn;\nhbL = gH * hvL + hq1L;\nhq1L = (gH * hvL + hbL) * keep;\nhlL = gH * hbL + hq2L;\nhq2L = (gH * hbL + hlL) * keep;\n// 1 LADDER, high-pass: four one-pole stages, zero-delay feedback (resonance at the cutoff, level loss like a Moog), tanh at the input\nxhL = tanh(rmfL);\nh4L = (qH4 * xhL - (qH4 * hs1L + qH3 * hs2L + qH2 * hs3L + qH * hs4L)) / (1 + kLadH * qH4);\nuhL = xhL - kLadH * h4L;\nhv1L = (uhL - hs1L) * GH; hy1L = hv1L + hs1L; hs1L = (hy1L + hv1L) * keep; hz1L = uhL - hy1L;\nhv2L = (hz1L - hs2L) * GH; hy2L = hv2L + hs2L; hs2L = (hy2L + hv2L) * keep; hz2L = hz1L - hy2L;\nhv3L = (hz2L - hs3L) * GH; hy3L = hv3L + hs3L; hs3L = (hy3L + hv3L) * keep; hz3L = hz2L - hy3L;\nhv4L = (hz3L - hs4L) * GH; hy4L = hv4L + hs4L; hs4L = (hy4L + hv4L) * keep; hz4L = hz3L - hy4L;\n// 2 MS-20, high-pass: 12 dB with a clipped input and a resonance that is damped by its own level (screams, then squashes)\nxmL = tanh(1.5 * rmfL) / 1.5;\nkmHL = kMsH + 0.6 * abs(hmbL);\nhdmL = 1 / (1 + gH * (gH + kmHL));\nhvmL = (xmL - (kmHL + gH) * hm1L - hm2L) * hdmL;\nhbmL = gH * hvmL + hm1L;\nhm1L = (gH * hvmL + hbmL) * keep;\nhlmL = gH * hbmL + hm2L;\nhm2L = (gH * hbmL + hlmL) * keep;\nhmbL = hbmL * keep;\n// 3 SOFT, high-pass: one pole, 6 dB/oct\nhsvL = (rmfL - hsoL) * GH; hsyL = hsvL + hsoL; hsoL = (hsyL + hsvL) * keep; hszL = rmfL - hsyL;\nhselL = f0 * hvL + f1 * hz4L * cmpH + f2 * hvmL + f3 * hszL;\n// 0 CLEAN, low-pass\nlvL = (hselL - (kL + gL) * lq1L - lq2L) * ldn;\nlbL = gL * lvL + lq1L;\nlq1L = (gL * lvL + lbL) * keep;\nllL = gL * lbL + lq2L;\nlq2L = (gL * lbL + llL) * keep;\n// 1 LADDER, low-pass: four one-pole stages with zero-delay feedback k*y4\nxlL = tanh(hselL);\ny4L = (GL4 * xlL + (GL3 * qL * ls1L + GL2 * qL * ls2L + GL * qL * ls3L + qL * ls4L)) / (1 + kLadL * GL4);\nulL = xlL - kLadL * y4L;\nlv1L = (ulL - ls1L) * GL; ly1L = lv1L + ls1L; ls1L = (ly1L + lv1L) * keep;\nlv2L = (ly1L - ls2L) * GL; ly2L = lv2L + ls2L; ls2L = (ly2L + lv2L) * keep;\nlv3L = (ly2L - ls3L) * GL; ly3L = lv3L + ls3L; ls3L = (ly3L + lv3L) * keep;\nlv4L = (ly3L - ls4L) * GL; ly4L = lv4L + ls4L; ls4L = (ly4L + lv4L) * keep;\n// 2 MS-20, low-pass\nxnL = tanh(1.5 * hselL) / 1.5;\nkmLL = kMsL + 0.6 * abs(lmbL);\nldmL = 1 / (1 + gL * (gL + kmLL));\nlvmL = (xnL - (kmLL + gL) * lm1L - lm2L) * ldmL;\nlbmL = gL * lvmL + lm1L;\nlm1L = (gL * lvmL + lbmL) * keep;\nllmL = gL * lbmL + lm2L;\nlm2L = (gL * lbmL + llmL) * keep;\nlmbL = lbmL * keep;\n// 3 SOFT, low-pass\nlsvL = (hselL - lsoL) * GL; lsyL = lsvL + lsoL; lsoL = (lsyL + lsvL) * keep;\nlselL = f0 * llL + f1 * ly4L * cmpL + f2 * llmL + f3 * lsyL;\n// tape saturation: soft limiter with unity small-signal gain, peak 1/drive\n// ---------------- FX slot: 0 OFF (exact bypass), 1 WAVEFOLDER, 2 SPRING REVERB, 3 BITCRUSHER\nfxiL = lselL;\n// the loop never exceeds 1/drive (tape stage), so wavefolder and bitcrusher see the signal scaled by drive: 1.0 = the loop's limit\nfxnL = fxiL * drv;\n// wavefolder: sine fold, gain 1 ... 15 into the folder, so a quiet signal stays clean and a loud one folds\nfxwL = sin(fa * fxnL) / drv;\n// spring reverb: two springs, each a delay with damped feedback behind a chain of dispersive all-passes (low frequencies late = the chirp)\nsq1L = sw1L - (sdt1 * 1); if (sq1L < 0) { sq1L = sq1L + 16384; }\nsj1L = floor(sq1L); sf1L = sq1L - sj1L;\nsr1L = (peek(sd1L, mod(sj1L, 16384)) * (1 - sf1L) + peek(sd1L, mod(sj1L + 1, 16384)) * sf1L) * keep;\nsl1L = (sl1L + sdmp * (sr1L - sl1L)) * keep;\nsu1L = fxiL + sfb1 * sl1L;\nsu1L = su1L * (abs(su1L) > 0.000000000000001);\nsy10L = -0.85 * su1L + ss10L; ss10L = (su1L - -0.85 * sy10L) * keep;\nsy11L = -0.85 * sy10L + ss11L; ss11L = (sy10L - -0.85 * sy11L) * keep;\nsy12L = -0.85 * sy11L + ss12L; ss12L = (sy11L - -0.85 * sy12L) * keep;\nsy13L = -0.85 * sy12L + ss13L; ss13L = (sy12L - -0.85 * sy13L) * keep;\nsy14L = -0.85 * sy13L + ss14L; ss14L = (sy13L - -0.85 * sy14L) * keep;\nsy15L = -0.85 * sy14L + ss15L; ss15L = (sy14L - -0.85 * sy15L) * keep;\nsy16L = -0.85 * sy15L + ss16L; ss16L = (sy15L - -0.85 * sy16L) * keep;\nsy17L = -0.85 * sy16L + ss17L; ss17L = (sy16L - -0.85 * sy17L) * keep;\nsy18L = -0.85 * sy17L + ss18L; ss18L = (sy17L - -0.85 * sy18L) * keep;\nsy19L = -0.85 * sy18L + ss19L; ss19L = (sy18L - -0.85 * sy19L) * keep;\nsy110L = -0.85 * sy19L + ss110L; ss110L = (sy19L - -0.85 * sy110L) * keep;\nsy111L = -0.85 * sy110L + ss111L; ss111L = (sy110L - -0.85 * sy111L) * keep;\nsy112L = -0.85 * sy111L + ss112L; ss112L = (sy111L - -0.85 * sy112L) * keep;\nsy113L = -0.85 * sy112L + ss113L; ss113L = (sy112L - -0.85 * sy113L) * keep;\nsy114L = -0.85 * sy113L + ss114L; ss114L = (sy113L - -0.85 * sy114L) * keep;\nsy115L = -0.85 * sy114L + ss115L; ss115L = (sy114L - -0.85 * sy115L) * keep;\nsy116L = -0.85 * sy115L + ss116L; ss116L = (sy115L - -0.85 * sy116L) * keep;\nsy117L = -0.85 * sy116L + ss117L; ss117L = (sy116L - -0.85 * sy117L) * keep;\nsy118L = -0.85 * sy117L + ss118L; ss118L = (sy117L - -0.85 * sy118L) * keep;\nsy119L = -0.85 * sy118L + ss119L; ss119L = (sy118L - -0.85 * sy119L) * keep;\nsy120L = -0.85 * sy119L + ss120L; ss120L = (sy119L - -0.85 * sy120L) * keep;\nsy121L = -0.85 * sy120L + ss121L; ss121L = (sy120L - -0.85 * sy121L) * keep;\nsy122L = -0.85 * sy121L + ss122L; ss122L = (sy121L - -0.85 * sy122L) * keep;\nsy123L = -0.85 * sy122L + ss123L; ss123L = (sy122L - -0.85 * sy123L) * keep;\npoke(sd1L, sy123L * keep, sw1L); sw1L = mod(sw1L + 1, 16384);\nsq2L = sw2L - (sdt2 * 1); if (sq2L < 0) { sq2L = sq2L + 16384; }\nsj2L = floor(sq2L); sf2L = sq2L - sj2L;\nsr2L = (peek(sd2L, mod(sj2L, 16384)) * (1 - sf2L) + peek(sd2L, mod(sj2L + 1, 16384)) * sf2L) * keep;\nsl2L = (sl2L + sdmp * (sr2L - sl2L)) * keep;\nsu2L = fxiL + sfb2 * sl2L;\nsu2L = su2L * (abs(su2L) > 0.000000000000001);\nsy20L = -0.85 * su2L + ss20L; ss20L = (su2L - -0.85 * sy20L) * keep;\nsy21L = -0.85 * sy20L + ss21L; ss21L = (sy20L - -0.85 * sy21L) * keep;\nsy22L = -0.85 * sy21L + ss22L; ss22L = (sy21L - -0.85 * sy22L) * keep;\nsy23L = -0.85 * sy22L + ss23L; ss23L = (sy22L - -0.85 * sy23L) * keep;\nsy24L = -0.85 * sy23L + ss24L; ss24L = (sy23L - -0.85 * sy24L) * keep;\nsy25L = -0.85 * sy24L + ss25L; ss25L = (sy24L - -0.85 * sy25L) * keep;\nsy26L = -0.85 * sy25L + ss26L; ss26L = (sy25L - -0.85 * sy26L) * keep;\nsy27L = -0.85 * sy26L + ss27L; ss27L = (sy26L - -0.85 * sy27L) * keep;\nsy28L = -0.85 * sy27L + ss28L; ss28L = (sy27L - -0.85 * sy28L) * keep;\nsy29L = -0.85 * sy28L + ss29L; ss29L = (sy28L - -0.85 * sy29L) * keep;\nsy210L = -0.85 * sy29L + ss210L; ss210L = (sy29L - -0.85 * sy210L) * keep;\nsy211L = -0.85 * sy210L + ss211L; ss211L = (sy210L - -0.85 * sy211L) * keep;\nsy212L = -0.85 * sy211L + ss212L; ss212L = (sy211L - -0.85 * sy212L) * keep;\nsy213L = -0.85 * sy212L + ss213L; ss213L = (sy212L - -0.85 * sy213L) * keep;\nsy214L = -0.85 * sy213L + ss214L; ss214L = (sy213L - -0.85 * sy214L) * keep;\nsy215L = -0.85 * sy214L + ss215L; ss215L = (sy214L - -0.85 * sy215L) * keep;\nsy216L = -0.85 * sy215L + ss216L; ss216L = (sy215L - -0.85 * sy216L) * keep;\nsy217L = -0.85 * sy216L + ss217L; ss217L = (sy216L - -0.85 * sy217L) * keep;\nsy218L = -0.85 * sy217L + ss218L; ss218L = (sy217L - -0.85 * sy218L) * keep;\nsy219L = -0.85 * sy218L + ss219L; ss219L = (sy218L - -0.85 * sy219L) * keep;\nsy220L = -0.85 * sy219L + ss220L; ss220L = (sy219L - -0.85 * sy220L) * keep;\nsy221L = -0.85 * sy220L + ss221L; ss221L = (sy220L - -0.85 * sy221L) * keep;\nsy222L = -0.85 * sy221L + ss222L; ss222L = (sy221L - -0.85 * sy222L) * keep;\nsy223L = -0.85 * sy222L + ss223L; ss223L = (sy222L - -0.85 * sy223L) * keep;\npoke(sd2L, sy223L * keep, sw2L); sw2L = mod(sw2L + 1, 16384);\nfxsL = (sr1L * snr1 + sr2L * snr2) * 0.7071;\n// bitcrusher: quantise to fbq bits (level dependent: a quiet signal is crushed harder), then sample & hold every bfac samples\nfqzL = floor(fxnL * bqv + 0.5) / (bqv * drv);\nbphL = bphL + 1 / bfac; btkL = bphL >= 1; bphL = bphL - btkL;\nbhdL = (bhdL + btkL * (fqzL - bhdL)) * keep;\nfxoL = e0 * fxiL + e1 * (fxiL * (1 - fxm) + fxwL * fxm) + e2 * (fxiL * (1 - fxm) + fxsL * fxm) + e3 * (fxiL * (1 - fxm) + bhdL * fxm);\nsvL = tanh(drv * fxoL) / drv;\n// delay type BBD: two more low-pass poles (dark repeats) and a little hiss, written into the loop\nbb1L = (bb1L + bba * (svL - bb1L)) * keep;\nbb2L = (bb2L + bba * (bb1L - bb2L)) * keep;\nswL = svL * (1 - kB) + (bb2L + 0.0003 * noise()) * kB;\nswL = swL * (abs(swL) > 0.000000000001);   // flush below 1e-12: nothing infinitesimal can grow back by itself (RESET stays empty)\npoke(dbL, swL * keep, wL);\nwL = mod(wL + 1, 131072);\nxpL = xL;\n// output tap = delay output; x <= 1/drive, so wet <= level\nyoL = in1 * (1 - wmx) + xL * drv * lvl * wmx;\n\n// ================= channel R =================\n// wow / flutter / random drift on the delay time\nphAR = phAR + 0.45 / samplerate; phAR = phAR - floor(phAR);\nphBR = phBR + 5.3 / samplerate;  phBR = phBR - floor(phBR);\nnzR = nzR + 0.0005 * (noise() - nzR);\nwmR = wowe * (0.02 * sin(6.283185307179586 * phAR) + 0.006 * sin(6.283185307179586 * phBR) + 0.09 * nzR);\ntdR = tau * (1 + 0.07 * spr) * (1 + wmR);\ntdR = max(64, min(131072 - 8, tdR));\n// the read position glides to the wanted delay instead of jumping (a jump is a click): one-pole (80 ms) with a speed limit of tdlim samples per sample,\n// so turning DELAY, SPRD or switching the delay type bends the pitch of the repeats like a tape echo instead of clicking\ntdiR = tdgR < 1;\ntdgR = tdgR * (1 - tdiR) + tdR * tdiR;\ntdgR = tdgR + max(0 - tdlim, min(tdlim, (tdR - tdgR) * tdk));\n// two taps of the delay line (read before this sample is written); RESET (keep = 0) silences them at once\nrpR = wR - tdgR;\nif (rpR < 0) { rpR = rpR + 131072; }\ni0R = floor(rpR); frR = rpR - i0R;\nxR = (peek(dbR, mod(i0R, 131072)) * (1 - frR) + peek(dbR, mod(i0R + 1, 131072)) * frR) * keep;\nrqR = wR - tdgR * 0.618;\nif (rqR < 0) { rqR = rqR + 131072; }\nj0R = floor(rqR); fqR = rqR - j0R;\nx2R = (peek(dbR, mod(j0R, 131072)) * (1 - fqR) + peek(dbR, mod(j0R + 1, 131072)) * fqR) * keep;\n// carrier: one phase, all waveforms computed, selected by the weights k0..k7 (no if-blocks: GenExpr scoping)\npoR = cphR;\ncphR = cphR + cf * (1 + 0.013 * spr) / samplerate; cphR = cphR - floor(cphR);\nwrR = cphR < poR;                                  // 1 on the sample where the phase wraps\nshR = shR + wrR * (noise() - shR);               // sample & hold: new random value at each wrap\nsaR = saR + wrR * (sbR - saR);                 // smooth random: glide from the old to the new value\nsbR = sbR + wrR * (noise() - sbR);\ncSR = sin(6.283185307179586 * cphR);\ncTR = 1 - 4 * abs(cphR - 0.5);\ncWR = 2 * cphR - 1;\ncQR = 1 - 2 * (cphR > 0.5);\ncMR = saR + (sbR - saR) * cphR * cphR * (3 - 2 * cphR);\ncXR = 0.15 + 0.85 * tanh(3 * drv * x2R);            // cross-feed; 0.15 = leak of an unbalanced ring modulator, lets the loop start\ncarR = k0 * cSR + k1 * cTR + k2 * cWR + k3 * cQR + k4 * shR + k5 * cMR + k6 * noise() + k7 * cXR;\n// delay type PING-PONG: each loop is fed by a mix of its own delay output and the other channel's (pp = 0 -> independent loops)\nxoR = xR * (1 - pp) + xL * pp;\n// mixer / hub: seed + noise floor + burst + feedback\nhubR = (in2 * sl + fbk2 * xoR + nf * noise() + bg * 0.3 * noise() + 0.00000000000000000001 * noise()) * keep;   // 1e-20: keeps the filter states away from denormals\n// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point\nrmoR = hubR * (1 - rde + rde * carR) * rnorm;\n// filter drive: saturates the signal going into the filters (0 = bypass, exact); small-signal gain rises with the drive\nrmfR = rmoR * (1 - fdr) + fdr * tanh(fdg * rmoR) / ftn;\n// ---------------- filter models: all four run in parallel on the same signal and the selected one is used, so switching never clicks.\n// High-pass first (input: ring modulator output), then low-pass (input: the selected high-pass). All states are cleared by RESET.\n// 0 CLEAN, high-pass: TPT state-variable filter, 12 dB/oct\nhvR = (rmfR - (kH + gH) * hq1R - hq2R) * hdn;\nhbR = gH * hvR + hq1R;\nhq1R = (gH * hvR + hbR) * keep;\nhlR = gH * hbR + hq2R;\nhq2R = (gH * hbR + hlR) * keep;\n// 1 LADDER, high-pass: four one-pole stages, zero-delay feedback (resonance at the cutoff, level loss like a Moog), tanh at the input\nxhR = tanh(rmfR);\nh4R = (qH4 * xhR - (qH4 * hs1R + qH3 * hs2R + qH2 * hs3R + qH * hs4R)) / (1 + kLadH * qH4);\nuhR = xhR - kLadH * h4R;\nhv1R = (uhR - hs1R) * GH; hy1R = hv1R + hs1R; hs1R = (hy1R + hv1R) * keep; hz1R = uhR - hy1R;\nhv2R = (hz1R - hs2R) * GH; hy2R = hv2R + hs2R; hs2R = (hy2R + hv2R) * keep; hz2R = hz1R - hy2R;\nhv3R = (hz2R - hs3R) * GH; hy3R = hv3R + hs3R; hs3R = (hy3R + hv3R) * keep; hz3R = hz2R - hy3R;\nhv4R = (hz3R - hs4R) * GH; hy4R = hv4R + hs4R; hs4R = (hy4R + hv4R) * keep; hz4R = hz3R - hy4R;\n// 2 MS-20, high-pass: 12 dB with a clipped input and a resonance that is damped by its own level (screams, then squashes)\nxmR = tanh(1.5 * rmfR) / 1.5;\nkmHR = kMsH + 0.6 * abs(hmbR);\nhdmR = 1 / (1 + gH * (gH + kmHR));\nhvmR = (xmR - (kmHR + gH) * hm1R - hm2R) * hdmR;\nhbmR = gH * hvmR + hm1R;\nhm1R = (gH * hvmR + hbmR) * keep;\nhlmR = gH * hbmR + hm2R;\nhm2R = (gH * hbmR + hlmR) * keep;\nhmbR = hbmR * keep;\n// 3 SOFT, high-pass: one pole, 6 dB/oct\nhsvR = (rmfR - hsoR) * GH; hsyR = hsvR + hsoR; hsoR = (hsyR + hsvR) * keep; hszR = rmfR - hsyR;\nhselR = f0 * hvR + f1 * hz4R * cmpH + f2 * hvmR + f3 * hszR;\n// 0 CLEAN, low-pass\nlvR = (hselR - (kL + gL) * lq1R - lq2R) * ldn;\nlbR = gL * lvR + lq1R;\nlq1R = (gL * lvR + lbR) * keep;\nllR = gL * lbR + lq2R;\nlq2R = (gL * lbR + llR) * keep;\n// 1 LADDER, low-pass: four one-pole stages with zero-delay feedback k*y4\nxlR = tanh(hselR);\ny4R = (GL4 * xlR + (GL3 * qL * ls1R + GL2 * qL * ls2R + GL * qL * ls3R + qL * ls4R)) / (1 + kLadL * GL4);\nulR = xlR - kLadL * y4R;\nlv1R = (ulR - ls1R) * GL; ly1R = lv1R + ls1R; ls1R = (ly1R + lv1R) * keep;\nlv2R = (ly1R - ls2R) * GL; ly2R = lv2R + ls2R; ls2R = (ly2R + lv2R) * keep;\nlv3R = (ly2R - ls3R) * GL; ly3R = lv3R + ls3R; ls3R = (ly3R + lv3R) * keep;\nlv4R = (ly3R - ls4R) * GL; ly4R = lv4R + ls4R; ls4R = (ly4R + lv4R) * keep;\n// 2 MS-20, low-pass\nxnR = tanh(1.5 * hselR) / 1.5;\nkmLR = kMsL + 0.6 * abs(lmbR);\nldmR = 1 / (1 + gL * (gL + kmLR));\nlvmR = (xnR - (kmLR + gL) * lm1R - lm2R) * ldmR;\nlbmR = gL * lvmR + lm1R;\nlm1R = (gL * lvmR + lbmR) * keep;\nllmR = gL * lbmR + lm2R;\nlm2R = (gL * lbmR + llmR) * keep;\nlmbR = lbmR * keep;\n// 3 SOFT, low-pass\nlsvR = (hselR - lsoR) * GL; lsyR = lsvR + lsoR; lsoR = (lsyR + lsvR) * keep;\nlselR = f0 * llR + f1 * ly4R * cmpL + f2 * llmR + f3 * lsyR;\n// tape saturation: soft limiter with unity small-signal gain, peak 1/drive\n// ---------------- FX slot: 0 OFF (exact bypass), 1 WAVEFOLDER, 2 SPRING REVERB, 3 BITCRUSHER\nfxiR = lselR;\n// the loop never exceeds 1/drive (tape stage), so wavefolder and bitcrusher see the signal scaled by drive: 1.0 = the loop's limit\nfxnR = fxiR * drv;\n// wavefolder: sine fold, gain 1 ... 15 into the folder, so a quiet signal stays clean and a loud one folds\nfxwR = sin(fa * fxnR) / drv;\n// spring reverb: two springs, each a delay with damped feedback behind a chain of dispersive all-passes (low frequencies late = the chirp)\nsq1R = sw1R - (sdt1 * 1.043); if (sq1R < 0) { sq1R = sq1R + 16384; }\nsj1R = floor(sq1R); sf1R = sq1R - sj1R;\nsr1R = (peek(sd1R, mod(sj1R, 16384)) * (1 - sf1R) + peek(sd1R, mod(sj1R + 1, 16384)) * sf1R) * keep;\nsl1R = (sl1R + sdmp * (sr1R - sl1R)) * keep;\nsu1R = fxiR + sfb1 * sl1R;\nsu1R = su1R * (abs(su1R) > 0.000000000000001);\nsy10R = -0.85 * su1R + ss10R; ss10R = (su1R - -0.85 * sy10R) * keep;\nsy11R = -0.85 * sy10R + ss11R; ss11R = (sy10R - -0.85 * sy11R) * keep;\nsy12R = -0.85 * sy11R + ss12R; ss12R = (sy11R - -0.85 * sy12R) * keep;\nsy13R = -0.85 * sy12R + ss13R; ss13R = (sy12R - -0.85 * sy13R) * keep;\nsy14R = -0.85 * sy13R + ss14R; ss14R = (sy13R - -0.85 * sy14R) * keep;\nsy15R = -0.85 * sy14R + ss15R; ss15R = (sy14R - -0.85 * sy15R) * keep;\nsy16R = -0.85 * sy15R + ss16R; ss16R = (sy15R - -0.85 * sy16R) * keep;\nsy17R = -0.85 * sy16R + ss17R; ss17R = (sy16R - -0.85 * sy17R) * keep;\nsy18R = -0.85 * sy17R + ss18R; ss18R = (sy17R - -0.85 * sy18R) * keep;\nsy19R = -0.85 * sy18R + ss19R; ss19R = (sy18R - -0.85 * sy19R) * keep;\nsy110R = -0.85 * sy19R + ss110R; ss110R = (sy19R - -0.85 * sy110R) * keep;\nsy111R = -0.85 * sy110R + ss111R; ss111R = (sy110R - -0.85 * sy111R) * keep;\nsy112R = -0.85 * sy111R + ss112R; ss112R = (sy111R - -0.85 * sy112R) * keep;\nsy113R = -0.85 * sy112R + ss113R; ss113R = (sy112R - -0.85 * sy113R) * keep;\nsy114R = -0.85 * sy113R + ss114R; ss114R = (sy113R - -0.85 * sy114R) * keep;\nsy115R = -0.85 * sy114R + ss115R; ss115R = (sy114R - -0.85 * sy115R) * keep;\nsy116R = -0.85 * sy115R + ss116R; ss116R = (sy115R - -0.85 * sy116R) * keep;\nsy117R = -0.85 * sy116R + ss117R; ss117R = (sy116R - -0.85 * sy117R) * keep;\nsy118R = -0.85 * sy117R + ss118R; ss118R = (sy117R - -0.85 * sy118R) * keep;\nsy119R = -0.85 * sy118R + ss119R; ss119R = (sy118R - -0.85 * sy119R) * keep;\nsy120R = -0.85 * sy119R + ss120R; ss120R = (sy119R - -0.85 * sy120R) * keep;\nsy121R = -0.85 * sy120R + ss121R; ss121R = (sy120R - -0.85 * sy121R) * keep;\nsy122R = -0.85 * sy121R + ss122R; ss122R = (sy121R - -0.85 * sy122R) * keep;\nsy123R = -0.85 * sy122R + ss123R; ss123R = (sy122R - -0.85 * sy123R) * keep;\npoke(sd1R, sy123R * keep, sw1R); sw1R = mod(sw1R + 1, 16384);\nsq2R = sw2R - (sdt2 * 1.057); if (sq2R < 0) { sq2R = sq2R + 16384; }\nsj2R = floor(sq2R); sf2R = sq2R - sj2R;\nsr2R = (peek(sd2R, mod(sj2R, 16384)) * (1 - sf2R) + peek(sd2R, mod(sj2R + 1, 16384)) * sf2R) * keep;\nsl2R = (sl2R + sdmp * (sr2R - sl2R)) * keep;\nsu2R = fxiR + sfb2 * sl2R;\nsu2R = su2R * (abs(su2R) > 0.000000000000001);\nsy20R = -0.85 * su2R + ss20R; ss20R = (su2R - -0.85 * sy20R) * keep;\nsy21R = -0.85 * sy20R + ss21R; ss21R = (sy20R - -0.85 * sy21R) * keep;\nsy22R = -0.85 * sy21R + ss22R; ss22R = (sy21R - -0.85 * sy22R) * keep;\nsy23R = -0.85 * sy22R + ss23R; ss23R = (sy22R - -0.85 * sy23R) * keep;\nsy24R = -0.85 * sy23R + ss24R; ss24R = (sy23R - -0.85 * sy24R) * keep;\nsy25R = -0.85 * sy24R + ss25R; ss25R = (sy24R - -0.85 * sy25R) * keep;\nsy26R = -0.85 * sy25R + ss26R; ss26R = (sy25R - -0.85 * sy26R) * keep;\nsy27R = -0.85 * sy26R + ss27R; ss27R = (sy26R - -0.85 * sy27R) * keep;\nsy28R = -0.85 * sy27R + ss28R; ss28R = (sy27R - -0.85 * sy28R) * keep;\nsy29R = -0.85 * sy28R + ss29R; ss29R = (sy28R - -0.85 * sy29R) * keep;\nsy210R = -0.85 * sy29R + ss210R; ss210R = (sy29R - -0.85 * sy210R) * keep;\nsy211R = -0.85 * sy210R + ss211R; ss211R = (sy210R - -0.85 * sy211R) * keep;\nsy212R = -0.85 * sy211R + ss212R; ss212R = (sy211R - -0.85 * sy212R) * keep;\nsy213R = -0.85 * sy212R + ss213R; ss213R = (sy212R - -0.85 * sy213R) * keep;\nsy214R = -0.85 * sy213R + ss214R; ss214R = (sy213R - -0.85 * sy214R) * keep;\nsy215R = -0.85 * sy214R + ss215R; ss215R = (sy214R - -0.85 * sy215R) * keep;\nsy216R = -0.85 * sy215R + ss216R; ss216R = (sy215R - -0.85 * sy216