// VINK-LOOP: recursive feedback network (ring modulator + filters + tape saturation + delay in a closed loop), stereo.
// Generated by build_vink.py - edit there, not here.
Param seedlvl(0.5, min=0, max=1);          // how much of the track audio seeds the loop
Param nfloor(0.25, min=0, max=1);          // noise floor injected into the loop (self-start)
Param fbk(0.9, min=0, max=1.5);            // loop gain; the loop holds from about 0.8 at the default resonance (higher resonance: lower; measured, see test)
Param ringd(0.5, min=0, max=1);            // ring modulator depth
Param cfreq(55, min=0.5, max=2000);        // carrier oscillator Hz
Param cwave(0, min=0, max=7);              // carrier: 0 sine, 1 triangle, 2 saw, 3 square, 4 sample-and-hold, 5 smooth random, 6 noise, 7 cross-feed (2nd delay tap)
Param hpf(80, min=20, max=400);
Param lpf(8000, min=1000, max=16000);
Param reso(0.2, min=0, max=1);              // resonance of both loop filters (low-pass full, high-pass about half)
Param satur(0.4, min=0, max=1);
Param dtype(0, min=0, max=3);              // delay type: 0 tape (wow/flutter), 1 digital (clean), 2 BBD (dark + hiss), 3 ping-pong (L and R feed each other)
Param dtime(180, min=20, max=500);         // ms
Param wow(0.25, min=0, max=1);
Param spread(0.3, min=0, max=1);
Param level(0.5, min=0, max=1);
Param wetmix(1, min=0, max=1);
Param burst(0, min=0, max=1);              // 1 = inject a noise burst (button holds it ~120 ms)
Param clear(0, min=0, max=1);              // 1 = RESET: silence the loop and zero delay + filter memory (button holds it ~750 ms)

History phAL(0); History phBL(0); History nzL(0); History cphL(0); History wL(0);
History shL(0); History saL(0); History sbL(0);
History hq1L(0); History hq2L(0); History lq1L(0); History lq2L(0); History bb1L(0); History bb2L(0); History xpL(0);
Data dbL(131072);
History phAR(0); History phBR(0); History nzR(0); History cphR(0); History wR(0);
History shR(0); History saR(0); History sbR(0);
History hq1R(0); History hq2R(0); History lq1R(0); History lq2R(0); History bb1R(0); History bb2R(0); History xpR(0);
Data dbR(131072);

// ---- parameters, clamped so that unset/zero values can never produce inf or NaN ----
sl = max(0, min(1, seedlvl));
nzp = max(0, min(1, nfloor));
nf = nzp * nzp * 0.05;
fbk2 = max(0, min(1.5, fbk));
rd = max(0, min(1, ringd));
cf = max(0.5, min(2000, cfreq));
wv = max(0, min(7, floor(cwave + 0.5)));
k0 = wv < 0.5;
k1 = (wv > 0.5) * (wv < 1.5);
k2 = (wv > 1.5) * (wv < 2.5);
k3 = (wv > 2.5) * (wv < 3.5);
k4 = (wv > 3.5) * (wv < 4.5);
k5 = (wv > 4.5) * (wv < 5.5);
k6 = (wv > 5.5) * (wv < 6.5);
k7 = wv > 6.5;
// mean square of each carrier (for the power normalisation of the ring modulator)
cpow = 0.5 * k0 + 0.3333 * k1 + 0.3333 * k2 + 1 * k3 + 0.3333 * k4 + 0.2 * k5 + 0.3333 * k6 + 0.5 * k7;
rde = rd * (1 - k7) + min(rd, 0.85) * k7;   // cross-feed: pure product with its own delayed tap would die, so RING is capped there
rnorm = 1 / sqrt((1 - rde) * (1 - rde) + cpow * rde * rde);
fcH = max(20, min(400, hpf));
fcL = min(max(1000, min(16000, lpf)), 0.45 * samplerate);
rs = max(0, min(1, reso));
kL = 1 / (0.707 + rs * rs * 10);               // damping = 1/Q: Q 0.707 (no resonance) ... 10.7
kH = 1 / (0.707 + rs * rs * 4);
gH = tan(3.141592653589793 * fcH / samplerate);
gL = tan(3.141592653589793 * fcL / samplerate);
hdn = 1 / (1 + gH * (gH + kH));
ldn = 1 / (1 + gL * (gL + kL));
bba = 1 - exp(-6.283185307179586 * 3500 / samplerate);
dv = max(0, min(3, floor(dtype + 0.5)));
kT = dv < 0.5;
kD = (dv > 0.5) * (dv < 1.5);
kB = (dv > 1.5) * (dv < 2.5);
pp = dv > 2.5;
wowe = max(0, min(1, wow)) * (kT + 0.5 * kB);   // wow/flutter: tape full, BBD half, digital and ping-pong none
drv = 1 + 5 * max(0, min(1, satur));
tau = max(20, min(500, dtime)) * 0.001 * samplerate;
spr = max(0, min(1, spread));
lvl = max(0, min(1, level));
wmx = max(0, min(1, wetmix));
bg = max(0, min(1, burst));
keep = 1 - max(0, min(1, clear));

// ================= channel L =================
// wow / flutter / random drift on the delay time
phAL = phAL + 0.45 / samplerate; phAL = phAL - floor(phAL);
phBL = phBL + 5.3 / samplerate;  phBL = phBL - floor(phBL);
nzL = nzL + 0.0005 * (noise() - nzL);
wmL = wowe * (0.02 * sin(6.283185307179586 * phAL) + 0.006 * sin(6.283185307179586 * phBL) + 0.09 * nzL);
tdL = tau * 1 * (1 + wmL);
tdL = max(64, min(131072 - 8, tdL));
// two taps of the delay line (read before this sample is written); RESET (keep = 0) silences them at once
rpL = wL - tdL;
if (rpL < 0) { rpL = rpL + 131072; }
i0L = floor(rpL); frL = rpL - i0L;
xL = (peek(dbL, mod(i0L, 131072)) * (1 - frL) + peek(dbL, mod(i0L + 1, 131072)) * frL) * keep;
rqL = wL - tdL * 0.618;
if (rqL < 0) { rqL = rqL + 131072; }
j0L = floor(rqL); fqL = rqL - j0L;
x2L = (peek(dbL, mod(j0L, 131072)) * (1 - fqL) + peek(dbL, mod(j0L + 1, 131072)) * fqL) * keep;
// carrier: one phase, all waveforms computed, selected by the weights k0..k7 (no if-blocks: GenExpr scoping)
poL = cphL;
cphL = cphL + cf * 1 / samplerate; cphL = cphL - floor(cphL);
wrL = cphL < poL;                                  // 1 on the sample where the phase wraps
shL = shL + wrL * (noise() - shL);               // sample & hold: new random value at each wrap
saL = saL + wrL * (sbL - saL);                 // smooth random: glide from the old to the new value
sbL = sbL + wrL * (noise() - sbL);
cSL = sin(6.283185307179586 * cphL);
cTL = 1 - 4 * abs(cphL - 0.5);
cWL = 2 * cphL - 1;
cQL = 1 - 2 * (cphL > 0.5);
cML = saL + (sbL - saL) * cphL * cphL * (3 - 2 * cphL);
cXL = 0.15 + 0.85 * tanh(3 * drv * x2L);            // cross-feed; 0.15 = leak of an unbalanced ring modulator, lets the loop start
carL = k0 * cSL + k1 * cTL + k2 * cWL + k3 * cQL + k4 * shL + k5 * cML + k6 * noise() + k7 * cXL;
// delay type PING-PONG: each loop is fed by a mix of its own delay output and the other channel's (pp = 0 -> independent loops)
xoL = xL * (1 - pp) + xpR * pp;
// mixer / hub: seed + noise floor + burst + feedback
hubL = (in1 * sl + fbk2 * xoL + nf * noise() + bg * 0.3 * noise() + 0.00000000000000000001 * noise()) * keep;   // 1e-20: keeps the filter states away from denormals
// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point
rmoL = hubL * (1 - rde + rde * carL) * rnorm;
// 2-pole high-pass and 2-pole low-pass as state-variable filters (TPT) with resonance; states are cleared by RESET
hvL = (rmoL - (kH + gH) * hq1L - hq2L) * hdn;
hbL = gH * hvL + hq1L;
hq1L = (gH * hvL + hbL) * keep;
hlL = gH * hbL + hq2L;
hq2L = (gH * hbL + hlL) * keep;
lvL = (hvL - (kL + gL) * lq1L - lq2L) * ldn;
lbL = gL * lvL + lq1L;
lq1L = (gL * lvL + lbL) * keep;
llL = gL * lbL + lq2L;
lq2L = (gL * lbL + llL) * keep;
// tape saturation: soft limiter with unity small-signal gain, peak 1/drive
svL = tanh(drv * llL) / drv;
// delay type BBD: two more low-pass poles (dark repeats) and a little hiss, written into the loop
bb1L = (bb1L + bba * (svL - bb1L)) * keep;
bb2L = (bb2L + bba * (bb1L - bb2L)) * keep;
swL = svL * (1 - kB) + (bb2L + 0.0003 * noise()) * kB;
swL = swL * (abs(swL) > 0.000000000001);   // flush below 1e-12: nothing infinitesimal can grow back by itself (RESET stays empty)
poke(dbL, swL * keep, wL);
wL = mod(wL + 1, 131072);
xpL = xL;
// output tap = delay output; x <= 1/drive, so wet <= level
out1 = in1 * (1 - wmx) + xL * drv * lvl * wmx;

// ================= channel R =================
// wow / flutter / random drift on the delay time
phAR = phAR + 0.45 / samplerate; phAR = phAR - floor(phAR);
phBR = phBR + 5.3 / samplerate;  phBR = phBR - floor(phBR);
nzR = nzR + 0.0005 * (noise() - nzR);
wmR = wowe * (0.02 * sin(6.283185307179586 * phAR) + 0.006 * sin(6.283185307179586 * phBR) + 0.09 * nzR);
tdR = tau * (1 + 0.07 * spr) * (1 + wmR);
tdR = max(64, min(131072 - 8, tdR));
// two taps of the delay line (read before this sample is written); RESET (keep = 0) silences them at once
rpR = wR - tdR;
if (rpR < 0) { rpR = rpR + 131072; }
i0R = floor(rpR); frR = rpR - i0R;
xR = (peek(dbR, mod(i0R, 131072)) * (1 - frR) + peek(dbR, mod(i0R + 1, 131072)) * frR) * keep;
rqR = wR - tdR * 0.618;
if (rqR < 0) { rqR = rqR + 131072; }
j0R = floor(rqR); fqR = rqR - j0R;
x2R = (peek(dbR, mod(j0R, 131072)) * (1 - fqR) + peek(dbR, mod(j0R + 1, 131072)) * fqR) * keep;
// carrier: one phase, all waveforms computed, selected by the weights k0..k7 (no if-blocks: GenExpr scoping)
poR = cphR;
cphR = cphR + cf * (1 + 0.013 * spr) / samplerate; cphR = cphR - floor(cphR);
wrR = cphR < poR;                                  // 1 on the sample where the phase wraps
shR = shR + wrR * (noise() - shR);               // sample & hold: new random value at each wrap
saR = saR + wrR * (sbR - saR);                 // smooth random: glide from the old to the new value
sbR = sbR + wrR * (noise() - sbR);
cSR = sin(6.283185307179586 * cphR);
cTR = 1 - 4 * abs(cphR - 0.5);
cWR = 2 * cphR - 1;
cQR = 1 - 2 * (cphR > 0.5);
cMR = saR + (sbR - saR) * cphR * cphR * (3 - 2 * cphR);
cXR = 0.15 + 0.85 * tanh(3 * drv * x2R);            // cross-feed; 0.15 = leak of an unbalanced ring modulator, lets the loop start
carR = k0 * cSR + k1 * cTR + k2 * cWR + k3 * cQR + k4 * shR + k5 * cMR + k6 * noise() + k7 * cXR;
// delay type PING-PONG: each loop is fed by a mix of its own delay output and the other channel's (pp = 0 -> independent loops)
xoR = xR * (1 - pp) + xL * pp;
// mixer / hub: seed + noise floor + burst + feedback
hubR = (in2 * sl + fbk2 * xoR + nf * noise() + bg * 0.3 * noise() + 0.00000000000000000001 * noise()) * keep;   // 1e-20: keeps the filter states away from denormals
// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point
rmoR = hubR * (1 - rde + rde * carR) * rnorm;
// 2-pole high-pass and 2-pole low-pass as state-variable filters (TPT) with resonance; states are cleared by RESET
hvR = (rmoR - (kH + gH) * hq1R - hq2R) * hdn;
hbR = gH * hvR + hq1R;
hq1R = (gH * hvR + hbR) * keep;
hlR = gH * hbR + hq2R;
hq2R = (gH * hbR + hlR) * keep;
lvR = (hvR - (kL + gL) * lq1R - lq2R) * ldn;
lbR = gL * lvR + lq1R;
lq1R = (gL * lvR + lbR) * keep;
llR = gL * lbR + lq2R;
lq2R = (gL * lbR + llR) * keep;
// tape saturation: soft limiter with unity small-signal gain, peak 1/drive
svR = tanh(drv * llR) / drv;
// delay type BBD: two more low-pass poles (dark repeats) and a little hiss, written into the loop
bb1R = (bb1R + bba * (svR - bb1R)) * keep;
bb2R = (bb2R + bba * (bb1R - bb2R)) * keep;
swR = svR * (1 - kB) + (bb2R + 0.0003 * noise()) * kB;
swR = swR * (abs(swR) > 0.000000000001);   // flush below 1e-12: nothing infinitesimal can grow back by itself (RESET stays empty)
poke(dbR, swR * keep, wR);
wR = mod(wR + 1, 131072);
xpR = xR;
// output tap = delay output; x <= 1/drive, so wet <= level
out2 = in2 * (1 - wmx) + xR * drv * lvl * wmx;
