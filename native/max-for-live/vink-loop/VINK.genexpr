// VINK-LOOP: recursive feedback network (ring modulator + filters + tape saturation + delay in a closed loop), stereo.
// Generated by build_vink.py - edit there, not here.
Param seedlvl(0.5, min=0, max=1);          // how much of the track audio seeds the loop
Param nfloor(0.25, min=0, max=1);          // noise floor injected into the loop (self-start)
Param fbk(0.9, min=0, max=1.5);            // loop gain; the loop holds from about 0.8 at the default resonance (higher resonance: lower; measured, see test)
Param ringd(0.5, min=0, max=1);            // ring modulator depth
Param cfreq(55, min=0.5, max=2000);        // carrier oscillator Hz
Param cwave(0, min=0, max=7);              // carrier: 0 sine, 1 triangle, 2 saw, 3 square, 4 sample-and-hold, 5 smooth random, 6 noise, 7 cross-feed (2nd delay tap)
Param hpf(80, min=20, max=400);
Param lpf(8000, min=1000, max=16000);
Param fdrive(0, min=0, max=1);             // drive into the filters (0 = off)
Param fxtype(0, min=0, max=3);             // FX slot between filter and tape: 0 off, 1 wavefolder, 2 spring reverb, 3 bitcrusher
Param fxfold(0.6, min=0, max=1);           // wavefolder amount
Param fxspring(0.6, min=0, max=1);         // spring reverb decay, 0.2 s ... 3 s (T60)
Param fxbits(0.88, min=0, max=1);          // bitcrusher: 0 = 16 bit ... 1 = 2 bit
Param fxrate(0.8, min=0, max=1);           // bitcrusher: sample-rate reduction, 0 = none ... 1 = 1/32
Param fxmix(1, min=0, max=1);              // wet/dry of the FX slot
Param ftype(0, min=0, max=3);              // filter character: 0 clean 12 dB, 1 ladder 24 dB, 2 MS-20 style 12 dB, 3 soft 6 dB
Param reso(0.2, min=0, max=1);              // resonance of both loop filters (low-pass full, high-pass about half)
Param satur(0.4, min=0, max=1);
Param dtype(0, min=0, max=3);              // delay type: 0 tape (wow/flutter), 1 digital (clean), 2 BBD (dark + hiss), 3 ping-pong (L and R feed each other)
Param dtime(180, min=20, max=500);         // ms
Param wow(0.25, min=0, max=1);
Param spread(0.3, min=0, max=1);
Param width(1, min=0, max=1);              // stereo width of the result: 0 mono, 1 as is (mid/side)
Param level(0.5, min=0, max=1);
Param wetmix(1, min=0, max=1);
Param burst(0, min=0, max=1);              // 1 = inject a noise burst (button holds it ~120 ms)
Param clear(0, min=0, max=1);              // 1 = RESET: silence the loop and zero delay + filter memory (button holds it ~750 ms)

History phAL(0); History phBL(0); History nzL(0); History cphL(0); History wL(0); History tdgL(0);
History shL(0); History saL(0); History sbL(0);
History hq1L(0); History hq2L(0); History lq1L(0); History lq2L(0); History bb1L(0); History bb2L(0); History xpL(0);
History hs1L(0); History hs2L(0); History hs3L(0); History hs4L(0); History hm1L(0); History hm2L(0); History hmbL(0); History hsoL(0);
History ls1L(0); History ls2L(0); History ls3L(0); History ls4L(0); History lm1L(0); History lm2L(0); History lmbL(0); History lsoL(0);
Data dbL(131072);
History bhdL(0); History bphL(0);
History sw1L(0); History sl1L(0); Data sd1L(16384);
History ss10L(0); History ss11L(0); History ss12L(0); History ss13L(0); History ss14L(0); History ss15L(0); History ss16L(0); History ss17L(0); History ss18L(0); History ss19L(0); History ss110L(0); History ss111L(0); History ss112L(0); History ss113L(0); History ss114L(0); History ss115L(0); History ss116L(0); History ss117L(0); History ss118L(0); History ss119L(0); History ss120L(0); History ss121L(0); History ss122L(0); History ss123L(0); 
History sw2L(0); History sl2L(0); Data sd2L(16384);
History ss20L(0); History ss21L(0); History ss22L(0); History ss23L(0); History ss24L(0); History ss25L(0); History ss26L(0); History ss27L(0); History ss28L(0); History ss29L(0); History ss210L(0); History ss211L(0); History ss212L(0); History ss213L(0); History ss214L(0); History ss215L(0); History ss216L(0); History ss217L(0); History ss218L(0); History ss219L(0); History ss220L(0); History ss221L(0); History ss222L(0); History ss223L(0); 
History phAR(0); History phBR(0); History nzR(0); History cphR(0); History wR(0); History tdgR(0);
History shR(0); History saR(0); History sbR(0);
History hq1R(0); History hq2R(0); History lq1R(0); History lq2R(0); History bb1R(0); History bb2R(0); History xpR(0);
History hs1R(0); History hs2R(0); History hs3R(0); History hs4R(0); History hm1R(0); History hm2R(0); History hmbR(0); History hsoR(0);
History ls1R(0); History ls2R(0); History ls3R(0); History ls4R(0); History lm1R(0); History lm2R(0); History lmbR(0); History lsoR(0);
Data dbR(131072);
History bhdR(0); History bphR(0);
History sw1R(0); History sl1R(0); Data sd1R(16384);
History ss10R(0); History ss11R(0); History ss12R(0); History ss13R(0); History ss14R(0); History ss15R(0); History ss16R(0); History ss17R(0); History ss18R(0); History ss19R(0); History ss110R(0); History ss111R(0); History ss112R(0); History ss113R(0); History ss114R(0); History ss115R(0); History ss116R(0); History ss117R(0); History ss118R(0); History ss119R(0); History ss120R(0); History ss121R(0); History ss122R(0); History ss123R(0); 
History sw2R(0); History sl2R(0); Data sd2R(16384);
History ss20R(0); History ss21R(0); History ss22R(0); History ss23R(0); History ss24R(0); History ss25R(0); History ss26R(0); History ss27R(0); History ss28R(0); History ss29R(0); History ss210R(0); History ss211R(0); History ss212R(0); History ss213R(0); History ss214R(0); History ss215R(0); History ss216R(0); History ss217R(0); History ss218R(0); History ss219R(0); History ss220R(0); History ss221R(0); History ss222R(0); History ss223R(0); 

// ---- parameters, clamped so that unset/zero values can never produce inf or NaN ----
sl = max(0, min(1, seedlvl));
nzp = max(0, min(1, nfloor));
nf = nzp * nzp * 0.05;
fbk2 = max(0, min(1.5, fbk));
rd = max(0, min(1, ringd));
cf = max(0.5, min(2000, cfreq));
wv = max(0, min(7, floor(cwave + 0.5)));
k0 = wv < 0.5;
k1 = (wv > 0.5) * (wv < 1.5);
k2 = (wv > 1.5) * (wv < 2.5);
k3 = (wv > 2.5) * (wv < 3.5);
k4 = (wv > 3.5) * (wv < 4.5);
k5 = (wv > 4.5) * (wv < 5.5);
k6 = (wv > 5.5) * (wv < 6.5);
k7 = wv > 6.5;
// mean square of each carrier (for the power normalisation of the ring modulator)
cpow = 0.5 * k0 + 0.3333 * k1 + 0.3333 * k2 + 1 * k3 + 0.3333 * k4 + 0.2 * k5 + 0.3333 * k6 + 0.5 * k7;
rde = rd * (1 - k7) + min(rd, 0.85) * k7;   // cross-feed: pure product with its own delayed tap would die, so RING is capped there
rnorm = 1 / sqrt((1 - rde) * (1 - rde) + cpow * rde * rde);
fcH = max(20, min(400, hpf));
fcL = min(max(1000, min(16000, lpf)), 0.45 * samplerate);
rs = max(0, min(1, reso));
kL = 1 / (0.707 + rs * rs * 10);               // damping = 1/Q: Q 0.707 (no resonance) ... 10.7
kH = 1 / (0.707 + rs * rs * 4);
gH = tan(3.141592653589793 * fcH / samplerate);
gL = tan(3.141592653589793 * fcL / samplerate);
hdn = 1 / (1 + gH * (gH + kH));
ldn = 1 / (1 + gL * (gL + kL));
qH = 1 / (1 + gH); GH = gH * qH; qH2 = qH * qH; qH3 = qH2 * qH; qH4 = qH3 * qH;
qL = 1 / (1 + gL); GL = gL * qL; GL2 = GL * GL; GL3 = GL2 * GL; GL4 = GL3 * GL;
kLadL = 3.8 * rs;                                // ladder resonance feedback (self-oscillation would be 4)
kLadH = 3.0 * rs;
cmpL = 1 + 0.75 * kLadL;                         // a real ladder loses level as the resonance rises; 75 % of that is made up so the loop can still hold
cmpH = 1 + 0.75 * kLadH;
kMsL = 1 / (0.707 + rs * rs * 20);               // MS-20 style: Q up to ~21 (low-pass), ~9 (high-pass), damped by its own level
kMsH = 1 / (0.707 + rs * rs * 8);
fdr = max(0, min(1, fdrive));
fdg = 1 + 4 * fdr;
ftn = tanh(fdg);
wdt = max(0, min(1, width));
ex = max(0, min(3, floor(fxtype + 0.5)));
e0 = ex < 0.5;
e1 = (ex > 0.5) * (ex < 1.5);
e2 = (ex > 1.5) * (ex < 2.5);
e3 = ex > 2.5;
bqv = pow(2, 15 - 14 * max(0, min(1, fxbits)));   // quantiser steps per unit: 32768 (16 bit) ... 2 (2 bit)
bfac = 1 + 31 * max(0, min(1, fxrate)) * max(0, min(1, fxrate));
fa = 1 + 14 * max(0, min(1, fxfold)) * max(0, min(1, fxfold));
spv = max(0, min(1, fxspring));
spt = 0.2 * pow(15, spv);                          // spring T60 in seconds
sfb1 = pow(10, -3 * 0.0313 / spt);                 // feedback per round trip so that the tail falls 60 dB in spt
sfb2 = pow(10, -3 * 0.0437 / spt);
snr1 = sqrt(1 - sfb1 * sfb1);                      // unit average power gain per spring
snr2 = sqrt(1 - sfb2 * sfb2);
sdt1 = 0.0313 * samplerate;
sdt2 = 0.0437 * samplerate;
sdmp = 1 - exp(-6.283185307179586 * 3500 / samplerate);   // springs are dark
fxm = max(0, min(1, fxmix));
fv = max(0, min(3, floor(ftype + 0.5)));
f0 = fv < 0.5;
f1 = (fv > 0.5) * (fv < 1.5);
f2 = (fv > 1.5) * (fv < 2.5);
f3 = fv > 2.5;
bba = 1 - exp(-6.283185307179586 * 3500 / samplerate);
dv = max(0, min(3, floor(dtype + 0.5)));
kT = dv < 0.5;
kD = (dv > 0.5) * (dv < 1.5);
kB = (dv > 1.5) * (dv < 2.5);
pp = dv > 2.5;
wowe = max(0, min(1, wow)) * (kT + 0.5 * kB);   // wow/flutter: tape full, BBD half, digital and ping-pong none
drv = 1 + 5 * max(0, min(1, satur));
tau = max(20, min(500, dtime)) * 0.001 * samplerate;
tdk = 1 / (0.08 * samplerate);                     // delay-time glide: 80 ms one-pole ...
tdlim = 0.4;                                       // ... limited to 0.4 samples per sample (read speed 0.6x ... 1.4x)
spr = max(0, min(1, spread));
lvl = max(0, min(1, level));
wmx = max(0, min(1, wetmix));
bg = max(0, min(1, burst));
keep = 1 - max(0, min(1, clear));

// ================= channel L =================
// wow / flutter / random drift on the delay time
phAL = phAL + 0.45 / samplerate; phAL = phAL - floor(phAL);
phBL = phBL + 5.3 / samplerate;  phBL = phBL - floor(phBL);
nzL = nzL + 0.0005 * (noise() - nzL);
wmL = wowe * (0.02 * sin(6.283185307179586 * phAL) + 0.006 * sin(6.283185307179586 * phBL) + 0.09 * nzL);
tdL = tau * 1 * (1 + wmL);
tdL = max(64, min(131072 - 8, tdL));
// the read position glides to the wanted delay instead of jumping (a jump is a click): one-pole (80 ms) with a speed limit of tdlim samples per sample,
// so turning DELAY, SPRD or switching the delay type bends the pitch of the repeats like a tape echo instead of clicking
tdiL = tdgL < 1;
tdgL = tdgL * (1 - tdiL) + tdL * tdiL;
tdgL = tdgL + max(0 - tdlim, min(tdlim, (tdL - tdgL) * tdk));
// two taps of the delay line (read before this sample is written); RESET (keep = 0) silences them at once
rpL = wL - tdgL;
if (rpL < 0) { rpL = rpL + 131072; }
i0L = floor(rpL); frL = rpL - i0L;
xL = (peek(dbL, mod(i0L, 131072)) * (1 - frL) + peek(dbL, mod(i0L + 1, 131072)) * frL) * keep;
rqL = wL - tdgL * 0.618;
if (rqL < 0) { rqL = rqL + 131072; }
j0L = floor(rqL); fqL = rqL - j0L;
x2L = (peek(dbL, mod(j0L, 131072)) * (1 - fqL) + peek(dbL, mod(j0L + 1, 131072)) * fqL) * keep;
// carrier: one phase, all waveforms computed, selected by the weights k0..k7 (no if-blocks: GenExpr scoping)
poL = cphL;
cphL = cphL + cf * 1 / samplerate; cphL = cphL - floor(cphL);
wrL = cphL < poL;                                  // 1 on the sample where the phase wraps
shL = shL + wrL * (noise() - shL);               // sample & hold: new random value at each wrap
saL = saL + wrL * (sbL - saL);                 // smooth random: glide from the old to the new value
sbL = sbL + wrL * (noise() - sbL);
cSL = sin(6.283185307179586 * cphL);
cTL = 1 - 4 * abs(cphL - 0.5);
cWL = 2 * cphL - 1;
cQL = 1 - 2 * (cphL > 0.5);
cML = saL + (sbL - saL) * cphL * cphL * (3 - 2 * cphL);
cXL = 0.15 + 0.85 * tanh(3 * drv * x2L);            // cross-feed; 0.15 = leak of an unbalanced ring modulator, lets the loop start
carL = k0 * cSL + k1 * cTL + k2 * cWL + k3 * cQL + k4 * shL + k5 * cML + k6 * noise() + k7 * cXL;
// delay type PING-PONG: each loop is fed by a mix of its own delay output and the other channel's (pp = 0 -> independent loops)
xoL = xL * (1 - pp) + xpR * pp;
// mixer / hub: seed + noise floor + burst + feedback
hubL = (in1 * sl + fbk2 * xoL + nf * noise() + bg * 0.3 * noise() + 0.00000000000000000001 * noise()) * keep;   // 1e-20: keeps the filter states away from denormals
// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point
rmoL = hubL * (1 - rde + rde * carL) * rnorm;
// filter drive: saturates the signal going into the filters (0 = bypass, exact); small-signal gain rises with the drive
rmfL = rmoL * (1 - fdr) + fdr * tanh(fdg * rmoL) / ftn;
// ---------------- filter models: all four run in parallel on the same signal and the selected one is used, so switching never clicks.
// High-pass first (input: ring modulator output), then low-pass (input: the selected high-pass). All states are cleared by RESET.
// 0 CLEAN, high-pass: TPT state-variable filter, 12 dB/oct
hvL = (rmfL - (kH + gH) * hq1L - hq2L) * hdn;
hbL = gH * hvL + hq1L;
hq1L = (gH * hvL + hbL) * keep;
hlL = gH * hbL + hq2L;
hq2L = (gH * hbL + hlL) * keep;
// 1 LADDER, high-pass: four one-pole stages, zero-delay feedback (resonance at the cutoff, level loss like a Moog), tanh at the input
xhL = tanh(rmfL);
h4L = (qH4 * xhL - (qH4 * hs1L + qH3 * hs2L + qH2 * hs3L + qH * hs4L)) / (1 + kLadH * qH4);
uhL = xhL - kLadH * h4L;
hv1L = (uhL - hs1L) * GH; hy1L = hv1L + hs1L; hs1L = (hy1L + hv1L) * keep; hz1L = uhL - hy1L;
hv2L = (hz1L - hs2L) * GH; hy2L = hv2L + hs2L; hs2L = (hy2L + hv2L) * keep; hz2L = hz1L - hy2L;
hv3L = (hz2L - hs3L) * GH; hy3L = hv3L + hs3L; hs3L = (hy3L + hv3L) * keep; hz3L = hz2L - hy3L;
hv4L = (hz3L - hs4L) * GH; hy4L = hv4L + hs4L; hs4L = (hy4L + hv4L) * keep; hz4L = hz3L - hy4L;
// 2 MS-20, high-pass: 12 dB with a clipped input and a resonance that is damped by its own level (screams, then squashes)
xmL = tanh(1.5 * rmfL) / 1.5;
kmHL = kMsH + 0.6 * abs(hmbL);
hdmL = 1 / (1 + gH * (gH + kmHL));
hvmL = (xmL - (kmHL + gH) * hm1L - hm2L) * hdmL;
hbmL = gH * hvmL + hm1L;
hm1L = (gH * hvmL + hbmL) * keep;
hlmL = gH * hbmL + hm2L;
hm2L = (gH * hbmL + hlmL) * keep;
hmbL = hbmL * keep;
// 3 SOFT, high-pass: one pole, 6 dB/oct
hsvL = (rmfL - hsoL) * GH; hsyL = hsvL + hsoL; hsoL = (hsyL + hsvL) * keep; hszL = rmfL - hsyL;
hselL = f0 * hvL + f1 * hz4L * cmpH + f2 * hvmL + f3 * hszL;
// 0 CLEAN, low-pass
lvL = (hselL - (kL + gL) * lq1L - lq2L) * ldn;
lbL = gL * lvL + lq1L;
lq1L = (gL * lvL + lbL) * keep;
llL = gL * lbL + lq2L;
lq2L = (gL * lbL + llL) * keep;
// 1 LADDER, low-pass: four one-pole stages with zero-delay feedback k*y4
xlL = tanh(hselL);
y4L = (GL4 * xlL + (GL3 * qL * ls1L + GL2 * qL * ls2L + GL * qL * ls3L + qL * ls4L)) / (1 + kLadL * GL4);
ulL = xlL - kLadL * y4L;
lv1L = (ulL - ls1L) * GL; ly1L = lv1L + ls1L; ls1L = (ly1L + lv1L) * keep;
lv2L = (ly1L - ls2L) * GL; ly2L = lv2L + ls2L; ls2L = (ly2L + lv2L) * keep;
lv3L = (ly2L - ls3L) * GL; ly3L = lv3L + ls3L; ls3L = (ly3L + lv3L) * keep;
lv4L = (ly3L - ls4L) * GL; ly4L = lv4L + ls4L; ls4L = (ly4L + lv4L) * keep;
// 2 MS-20, low-pass
xnL = tanh(1.5 * hselL) / 1.5;
kmLL = kMsL + 0.6 * abs(lmbL);
ldmL = 1 / (1 + gL * (gL + kmLL));
lvmL = (xnL - (kmLL + gL) * lm1L - lm2L) * ldmL;
lbmL = gL * lvmL + lm1L;
lm1L = (gL * lvmL + lbmL) * keep;
llmL = gL * lbmL + lm2L;
lm2L = (gL * lbmL + llmL) * keep;
lmbL = lbmL * keep;
// 3 SOFT, low-pass
lsvL = (hselL - lsoL) * GL; lsyL = lsvL + lsoL; lsoL = (lsyL + lsvL) * keep;
lselL = f0 * llL + f1 * ly4L * cmpL + f2 * llmL + f3 * lsyL;
// tape saturation: soft limiter with unity small-signal gain, peak 1/drive
// ---------------- FX slot: 0 OFF (exact bypass), 1 WAVEFOLDER, 2 SPRING REVERB, 3 BITCRUSHER
fxiL = lselL;
// the loop never exceeds 1/drive (tape stage), so wavefolder and bitcrusher see the signal scaled by drive: 1.0 = the loop's limit
fxnL = fxiL * drv;
// wavefolder: sine fold, gain 1 ... 15 into the folder, so a quiet signal stays clean and a loud one folds
fxwL = sin(fa * fxnL) / drv;
// spring reverb: two springs, each a delay with damped feedback behind a chain of dispersive all-passes (low frequencies late = the chirp)
sq1L = sw1L - (sdt1 * 1); if (sq1L < 0) { sq1L = sq1L + 16384; }
sj1L = floor(sq1L); sf1L = sq1L - sj1L;
sr1L = (peek(sd1L, mod(sj1L, 16384)) * (1 - sf1L) + peek(sd1L, mod(sj1L + 1, 16384)) * sf1L) * keep;
sl1L = (sl1L + sdmp * (sr1L - sl1L)) * keep;
su1L = fxiL + sfb1 * sl1L;
su1L = su1L * (abs(su1L) > 0.000000000000001);
sy10L = -0.85 * su1L + ss10L; ss10L = (su1L - -0.85 * sy10L) * keep;
sy11L = -0.85 * sy10L + ss11L; ss11L = (sy10L - -0.85 * sy11L) * keep;
sy12L = -0.85 * sy11L + ss12L; ss12L = (sy11L - -0.85 * sy12L) * keep;
sy13L = -0.85 * sy12L + ss13L; ss13L = (sy12L - -0.85 * sy13L) * keep;
sy14L = -0.85 * sy13L + ss14L; ss14L = (sy13L - -0.85 * sy14L) * keep;
sy15L = -0.85 * sy14L + ss15L; ss15L = (sy14L - -0.85 * sy15L) * keep;
sy16L = -0.85 * sy15L + ss16L; ss16L = (sy15L - -0.85 * sy16L) * keep;
sy17L = -0.85 * sy16L + ss17L; ss17L = (sy16L - -0.85 * sy17L) * keep;
sy18L = -0.85 * sy17L + ss18L; ss18L = (sy17L - -0.85 * sy18L) * keep;
sy19L = -0.85 * sy18L + ss19L; ss19L = (sy18L - -0.85 * sy19L) * keep;
sy110L = -0.85 * sy19L + ss110L; ss110L = (sy19L - -0.85 * sy110L) * keep;
sy111L = -0.85 * sy110L + ss111L; ss111L = (sy110L - -0.85 * sy111L) * keep;
sy112L = -0.85 * sy111L + ss112L; ss112L = (sy111L - -0.85 * sy112L) * keep;
sy113L = -0.85 * sy112L + ss113L; ss113L = (sy112L - -0.85 * sy113L) * keep;
sy114L = -0.85 * sy113L + ss114L; ss114L = (sy113L - -0.85 * sy114L) * keep;
sy115L = -0.85 * sy114L + ss115L; ss115L = (sy114L - -0.85 * sy115L) * keep;
sy116L = -0.85 * sy115L + ss116L; ss116L = (sy115L - -0.85 * sy116L) * keep;
sy117L = -0.85 * sy116L + ss117L; ss117L = (sy116L - -0.85 * sy117L) * keep;
sy118L = -0.85 * sy117L + ss118L; ss118L = (sy117L - -0.85 * sy118L) * keep;
sy119L = -0.85 * sy118L + ss119L; ss119L = (sy118L - -0.85 * sy119L) * keep;
sy120L = -0.85 * sy119L + ss120L; ss120L = (sy119L - -0.85 * sy120L) * keep;
sy121L = -0.85 * sy120L + ss121L; ss121L = (sy120L - -0.85 * sy121L) * keep;
sy122L = -0.85 * sy121L + ss122L; ss122L = (sy121L - -0.85 * sy122L) * keep;
sy123L = -0.85 * sy122L + ss123L; ss123L = (sy122L - -0.85 * sy123L) * keep;
poke(sd1L, sy123L * keep, sw1L); sw1L = mod(sw1L + 1, 16384);
sq2L = sw2L - (sdt2 * 1); if (sq2L < 0) { sq2L = sq2L + 16384; }
sj2L = floor(sq2L); sf2L = sq2L - sj2L;
sr2L = (peek(sd2L, mod(sj2L, 16384)) * (1 - sf2L) + peek(sd2L, mod(sj2L + 1, 16384)) * sf2L) * keep;
sl2L = (sl2L + sdmp * (sr2L - sl2L)) * keep;
su2L = fxiL + sfb2 * sl2L;
su2L = su2L * (abs(su2L) > 0.000000000000001);
sy20L = -0.85 * su2L + ss20L; ss20L = (su2L - -0.85 * sy20L) * keep;
sy21L = -0.85 * sy20L + ss21L; ss21L = (sy20L - -0.85 * sy21L) * keep;
sy22L = -0.85 * sy21L + ss22L; ss22L = (sy21L - -0.85 * sy22L) * keep;
sy23L = -0.85 * sy22L + ss23L; ss23L = (sy22L - -0.85 * sy23L) * keep;
sy24L = -0.85 * sy23L + ss24L; ss24L = (sy23L - -0.85 * sy24L) * keep;
sy25L = -0.85 * sy24L + ss25L; ss25L = (sy24L - -0.85 * sy25L) * keep;
sy26L = -0.85 * sy25L + ss26L; ss26L = (sy25L - -0.85 * sy26L) * keep;
sy27L = -0.85 * sy26L + ss27L; ss27L = (sy26L - -0.85 * sy27L) * keep;
sy28L = -0.85 * sy27L + ss28L; ss28L = (sy27L - -0.85 * sy28L) * keep;
sy29L = -0.85 * sy28L + ss29L; ss29L = (sy28L - -0.85 * sy29L) * keep;
sy210L = -0.85 * sy29L + ss210L; ss210L = (sy29L - -0.85 * sy210L) * keep;
sy211L = -0.85 * sy210L + ss211L; ss211L = (sy210L - -0.85 * sy211L) * keep;
sy212L = -0.85 * sy211L + ss212L; ss212L = (sy211L - -0.85 * sy212L) * keep;
sy213L = -0.85 * sy212L + ss213L; ss213L = (sy212L - -0.85 * sy213L) * keep;
sy214L = -0.85 * sy213L + ss214L; ss214L = (sy213L - -0.85 * sy214L) * keep;
sy215L = -0.85 * sy214L + ss215L; ss215L = (sy214L - -0.85 * sy215L) * keep;
sy216L = -0.85 * sy215L + ss216L; ss216L = (sy215L - -0.85 * sy216L) * keep;
sy217L = -0.85 * sy216L + ss217L; ss217L = (sy216L - -0.85 * sy217L) * keep;
sy218L = -0.85 * sy217L + ss218L; ss218L = (sy217L - -0.85 * sy218L) * keep;
sy219L = -0.85 * sy218L + ss219L; ss219L = (sy218L - -0.85 * sy219L) * keep;
sy220L = -0.85 * sy219L + ss220L; ss220L = (sy219L - -0.85 * sy220L) * keep;
sy221L = -0.85 * sy220L + ss221L; ss221L = (sy220L - -0.85 * sy221L) * keep;
sy222L = -0.85 * sy221L + ss222L; ss222L = (sy221L - -0.85 * sy222L) * keep;
sy223L = -0.85 * sy222L + ss223L; ss223L = (sy222L - -0.85 * sy223L) * keep;
poke(sd2L, sy223L * keep, sw2L); sw2L = mod(sw2L + 1, 16384);
fxsL = (sr1L * snr1 + sr2L * snr2) * 0.7071;
// bitcrusher: quantise to fbq bits (level dependent: a quiet signal is crushed harder), then sample & hold every bfac samples
fqzL = floor(fxnL * bqv + 0.5) / (bqv * drv);
bphL = bphL + 1 / bfac; btkL = bphL >= 1; bphL = bphL - btkL;
bhdL = (bhdL + btkL * (fqzL - bhdL)) * keep;
fxoL = e0 * fxiL + e1 * (fxiL * (1 - fxm) + fxwL * fxm) + e2 * (fxiL * (1 - fxm) + fxsL * fxm) + e3 * (fxiL * (1 - fxm) + bhdL * fxm);
svL = tanh(drv * fxoL) / drv;
// delay type BBD: two more low-pass poles (dark repeats) and a little hiss, written into the loop
bb1L = (bb1L + bba * (svL - bb1L)) * keep;
bb2L = (bb2L + bba * (bb1L - bb2L)) * keep;
swL = svL * (1 - kB) + (bb2L + 0.0003 * noise()) * kB;
swL = swL * (abs(swL) > 0.000000000001);   // flush below 1e-12: nothing infinitesimal can grow back by itself (RESET stays empty)
poke(dbL, swL * keep, wL);
wL = mod(wL + 1, 131072);
xpL = xL;
// output tap = delay output; x <= 1/drive, so wet <= level
yoL = in1 * (1 - wmx) + xL * drv * lvl * wmx;

// ================= channel R =================
// wow / flutter / random drift on the delay time
phAR = phAR + 0.45 / samplerate; phAR = phAR - floor(phAR);
phBR = phBR + 5.3 / samplerate;  phBR = phBR - floor(phBR);
nzR = nzR + 0.0005 * (noise() - nzR);
wmR = wowe * (0.02 * sin(6.283185307179586 * phAR) + 0.006 * sin(6.283185307179586 * phBR) + 0.09 * nzR);
tdR = tau * (1 + 0.07 * spr) * (1 + wmR);
tdR = max(64, min(131072 - 8, tdR));
// the read position glides to the wanted delay instead of jumping (a jump is a click): one-pole (80 ms) with a speed limit of tdlim samples per sample,
// so turning DELAY, SPRD or switching the delay type bends the pitch of the repeats like a tape echo instead of clicking
tdiR = tdgR < 1;
tdgR = tdgR * (1 - tdiR) + tdR * tdiR;
tdgR = tdgR + max(0 - tdlim, min(tdlim, (tdR - tdgR) * tdk));
// two taps of the delay line (read before this sample is written); RESET (keep = 0) silences them at once
rpR = wR - tdgR;
if (rpR < 0) { rpR = rpR + 131072; }
i0R = floor(rpR); frR = rpR - i0R;
xR = (peek(dbR, mod(i0R, 131072)) * (1 - frR) + peek(dbR, mod(i0R + 1, 131072)) * frR) * keep;
rqR = wR - tdgR * 0.618;
if (rqR < 0) { rqR = rqR + 131072; }
j0R = floor(rqR); fqR = rqR - j0R;
x2R = (peek(dbR, mod(j0R, 131072)) * (1 - fqR) + peek(dbR, mod(j0R + 1, 131072)) * fqR) * keep;
// carrier: one phase, all waveforms computed, selected by the weights k0..k7 (no if-blocks: GenExpr scoping)
poR = cphR;
cphR = cphR + cf * (1 + 0.013 * spr) / samplerate; cphR = cphR - floor(cphR);
wrR = cphR < poR;                                  // 1 on the sample where the phase wraps
shR = shR + wrR * (noise() - shR);               // sample & hold: new random value at each wrap
saR = saR + wrR * (sbR - saR);                 // smooth random: glide from the old to the new value
sbR = sbR + wrR * (noise() - sbR);
cSR = sin(6.283185307179586 * cphR);
cTR = 1 - 4 * abs(cphR - 0.5);
cWR = 2 * cphR - 1;
cQR = 1 - 2 * (cphR > 0.5);
cMR = saR + (sbR - saR) * cphR * cphR * (3 - 2 * cphR);
cXR = 0.15 + 0.85 * tanh(3 * drv * x2R);            // cross-feed; 0.15 = leak of an unbalanced ring modulator, lets the loop start
carR = k0 * cSR + k1 * cTR + k2 * cWR + k3 * cQR + k4 * shR + k5 * cMR + k6 * noise() + k7 * cXR;
// delay type PING-PONG: each loop is fed by a mix of its own delay output and the other channel's (pp = 0 -> independent loops)
xoR = xR * (1 - pp) + xL * pp;
// mixer / hub: seed + noise floor + burst + feedback
hubR = (in2 * sl + fbk2 * xoR + nf * noise() + bg * 0.3 * noise() + 0.00000000000000000001 * noise()) * keep;   // 1e-20: keeps the filter states away from denormals
// ring modulator (blend: 0 = bypass, 1 = pure multiplication), power-normalised so that FEEDBACK 1.0 stays the unity point
rmoR = hubR * (1 - rde + rde * carR) * rnorm;
// filter drive: saturates the signal going into the filters (0 = bypass, exact); small-signal gain rises with the drive
rmfR = rmoR * (1 - fdr) + fdr * tanh(fdg * rmoR) / ftn;
// ---------------- filter models: all four run in parallel on the same signal and the selected one is used, so switching never clicks.
// High-pass first (input: ring modulator output), then low-pass (input: the selected high-pass). All states are cleared by RESET.
// 0 CLEAN, high-pass: TPT state-variable filter, 12 dB/oct
hvR = (rmfR - (kH + gH) * hq1R - hq2R) * hdn;
hbR = gH * hvR + hq1R;
hq1R = (gH * hvR + hbR) * keep;
hlR = gH * hbR + hq2R;
hq2R = (gH * hbR + hlR) * keep;
// 1 LADDER, high-pass: four one-pole stages, zero-delay feedback (resonance at the cutoff, level loss like a Moog), tanh at the input
xhR = tanh(rmfR);
h4R = (qH4 * xhR - (qH4 * hs1R + qH3 * hs2R + qH2 * hs3R + qH * hs4R)) / (1 + kLadH * qH4);
uhR = xhR - kLadH * h4R;
hv1R = (uhR - hs1R) * GH; hy1R = hv1R + hs1R; hs1R = (hy1R + hv1R) * keep; hz1R = uhR - hy1R;
hv2R = (hz1R - hs2R) * GH; hy2R = hv2R + hs2R; hs2R = (hy2R + hv2R) * keep; hz2R = hz1R - hy2R;
hv3R = (hz2R - hs3R) * GH; hy3R = hv3R + hs3R; hs3R = (hy3R + hv3R) * keep; hz3R = hz2R - hy3R;
hv4R = (hz3R - hs4R) * GH; hy4R = hv4R + hs4R; hs4R = (hy4R + hv4R) * keep; hz4R = hz3R - hy4R;
// 2 MS-20, high-pass: 12 dB with a clipped input and a resonance that is damped by its own level (screams, then squashes)
xmR = tanh(1.5 * rmfR) / 1.5;
kmHR = kMsH + 0.6 * abs(hmbR);
hdmR = 1 / (1 + gH * (gH + kmHR));
hvmR = (xmR - (kmHR + gH) * hm1R - hm2R) * hdmR;
hbmR = gH * hvmR + hm1R;
hm1R = (gH * hvmR + hbmR) * keep;
hlmR = gH * hbmR + hm2R;
hm2R = (gH * hbmR + hlmR) * keep;
hmbR = hbmR * keep;
// 3 SOFT, high-pass: one pole, 6 dB/oct
hsvR = (rmfR - hsoR) * GH; hsyR = hsvR + hsoR; hsoR = (hsyR + hsvR) * keep; hszR = rmfR - hsyR;
hselR = f0 * hvR + f1 * hz4R * cmpH + f2 * hvmR + f3 * hszR;
// 0 CLEAN, low-pass
lvR = (hselR - (kL + gL) * lq1R - lq2R) * ldn;
lbR = gL * lvR + lq1R;
lq1R = (gL * lvR + lbR) * keep;
llR = gL * lbR + lq2R;
lq2R = (gL * lbR + llR) * keep;
// 1 LADDER, low-pass: four one-pole stages with zero-delay feedback k*y4
xlR = tanh(hselR);
y4R = (GL4 * xlR + (GL3 * qL * ls1R + GL2 * qL * ls2R + GL * qL * ls3R + qL * ls4R)) / (1 + kLadL * GL4);
ulR = xlR - kLadL * y4R;
lv1R = (ulR - ls1R) * GL; ly1R = lv1R + ls1R; ls1R = (ly1R + lv1R) * keep;
lv2R = (ly1R - ls2R) * GL; ly2R = lv2R + ls2R; ls2R = (ly2R + lv2R) * keep;
lv3R = (ly2R - ls3R) * GL; ly3R = lv3R + ls3R; ls3R = (ly3R + lv3R) * keep;
lv4R = (ly3R - ls4R) * GL; ly4R = lv4R + ls4R; ls4R = (ly4R + lv4R) * keep;
// 2 MS-20, low-pass
xnR = tanh(1.5 * hselR) / 1.5;
kmLR = kMsL + 0.6 * abs(lmbR);
ldmR = 1 / (1 + gL * (gL + kmLR));
lvmR = (xnR - (kmLR + gL) * lm1R - lm2R) * ldmR;
lbmR = gL * lvmR + lm1R;
lm1R = (gL * lvmR + lbmR) * keep;
llmR = gL * lbmR + lm2R;
lm2R = (gL * lbmR + llmR) * keep;
lmbR = lbmR * keep;
// 3 SOFT, low-pass
lsvR = (hselR - lsoR) * GL; lsyR = lsvR + lsoR; lsoR = (lsyR + lsvR) * keep;
lselR = f0 * llR + f1 * ly4R * cmpL + f2 * llmR + f3 * lsyR;
// tape saturation: soft limiter with unity small-signal gain, peak 1/drive
// ---------------- FX slot: 0 OFF (exact bypass), 1 WAVEFOLDER, 2 SPRING REVERB, 3 BITCRUSHER
fxiR = lselR;
// the loop never exceeds 1/drive (tape stage), so wavefolder and bitcrusher see the signal scaled by drive: 1.0 = the loop's limit
fxnR = fxiR * drv;
// wavefolder: sine fold, gain 1 ... 15 into the folder, so a quiet signal stays clean and a loud one folds
fxwR = sin(fa * fxnR) / drv;
// spring reverb: two springs, each a delay with damped feedback behind a chain of dispersive all-passes (low frequencies late = the chirp)
sq1R = sw1R - (sdt1 * 1.043); if (sq1R < 0) { sq1R = sq1R + 16384; }
sj1R = floor(sq1R); sf1R = sq1R - sj1R;
sr1R = (peek(sd1R, mod(sj1R, 16384)) * (1 - sf1R) + peek(sd1R, mod(sj1R + 1, 16384)) * sf1R) * keep;
sl1R = (sl1R + sdmp * (sr1R - sl1R)) * keep;
su1R = fxiR + sfb1 * sl1R;
su1R = su1R * (abs(su1R) > 0.000000000000001);
sy10R = -0.85 * su1R + ss10R; ss10R = (su1R - -0.85 * sy10R) * keep;
sy11R = -0.85 * sy10R + ss11R; ss11R = (sy10R - -0.85 * sy11R) * keep;
sy12R = -0.85 * sy11R + ss12R; ss12R = (sy11R - -0.85 * sy12R) * keep;
sy13R = -0.85 * sy12R + ss13R; ss13R = (sy12R - -0.85 * sy13R) * keep;
sy14R = -0.85 * sy13R + ss14R; ss14R = (sy13R - -0.85 * sy14R) * keep;
sy15R = -0.85 * sy14R + ss15R; ss15R = (sy14R - -0.85 * sy15R) * keep;
sy16R = -0.85 * sy15R + ss16R; ss16R = (sy15R - -0.85 * sy16R) * keep;
sy17R = -0.85 * sy16R + ss17R; ss17R = (sy16R - -0.85 * sy17R) * keep;
sy18R = -0.85 * sy17R + ss18R; ss18R = (sy17R - -0.85 * sy18R) * keep;
sy19R = -0.85 * sy18R + ss19R; ss19R = (sy18R - -0.85 * sy19R) * keep;
sy110R = -0.85 * sy19R + ss110R; ss110R = (sy19R - -0.85 * sy110R) * keep;
sy111R = -0.85 * sy110R + ss111R; ss111R = (sy110R - -0.85 * sy111R) * keep;
sy112R = -0.85 * sy111R + ss112R; ss112R = (sy111R - -0.85 * sy112R) * keep;
sy113R = -0.85 * sy112R + ss113R; ss113R = (sy112R - -0.85 * sy113R) * keep;
sy114R = -0.85 * sy113R + ss114R; ss114R = (sy113R - -0.85 * sy114R) * keep;
sy115R = -0.85 * sy114R + ss115R; ss115R = (sy114R - -0.85 * sy115R) * keep;
sy116R = -0.85 * sy115R + ss116R; ss116R = (sy115R - -0.85 * sy116R) * keep;
sy117R = -0.85 * sy116R + ss117R; ss117R = (sy116R - -0.85 * sy117R) * keep;
sy118R = -0.85 * sy117R + ss118R; ss118R = (sy117R - -0.85 * sy118R) * keep;
sy119R = -0.85 * sy118R + ss119R; ss119R = (sy118R - -0.85 * sy119R) * keep;
sy120R = -0.85 * sy119R + ss120R; ss120R = (sy119R - -0.85 * sy120R) * keep;
sy121R = -0.85 * sy120R + ss121R; ss121R = (sy120R - -0.85 * sy121R) * keep;
sy122R = -0.85 * sy121R + ss122R; ss122R = (sy121R - -0.85 * sy122R) * keep;
sy123R = -0.85 * sy122R + ss123R; ss123R = (sy122R - -0.85 * sy123R) * keep;
poke(sd1R, sy123R * keep, sw1R); sw1R = mod(sw1R + 1, 16384);
sq2R = sw2R - (sdt2 * 1.057); if (sq2R < 0) { sq2R = sq2R + 16384; }
sj2R = floor(sq2R); sf2R = sq2R - sj2R;
sr2R = (peek(sd2R, mod(sj2R, 16384)) * (1 - sf2R) + peek(sd2R, mod(sj2R + 1, 16384)) * sf2R) * keep;
sl2R = (sl2R + sdmp * (sr2R - sl2R)) * keep;
su2R = fxiR + sfb2 * sl2R;
su2R = su2R * (abs(su2R) > 0.000000000000001);
sy20R = -0.85 * su2R + ss20R; ss20R = (su2R - -0.85 * sy20R) * keep;
sy21R = -0.85 * sy20R + ss21R; ss21R = (sy20R - -0.85 * sy21R) * keep;
sy22R = -0.85 * sy21R + ss22R; ss22R = (sy21R - -0.85 * sy22R) * keep;
sy23R = -0.85 * sy22R + ss23R; ss23R = (sy22R - -0.85 * sy23R) * keep;
sy24R = -0.85 * sy23R + ss24R; ss24R = (sy23R - -0.85 * sy24R) * keep;
sy25R = -0.85 * sy24R + ss25R; ss25R = (sy24R - -0.85 * sy25R) * keep;
sy26R = -0.85 * sy25R + ss26R; ss26R = (sy25R - -0.85 * sy26R) * keep;
sy27R = -0.85 * sy26R + ss27R; ss27R = (sy26R - -0.85 * sy27R) * keep;
sy28R = -0.85 * sy27R + ss28R; ss28R = (sy27R - -0.85 * sy28R) * keep;
sy29R = -0.85 * sy28R + ss29R; ss29R = (sy28R - -0.85 * sy29R) * keep;
sy210R = -0.85 * sy29R + ss210R; ss210R = (sy29R - -0.85 * sy210R) * keep;
sy211R = -0.85 * sy210R + ss211R; ss211R = (sy210R - -0.85 * sy211R) * keep;
sy212R = -0.85 * sy211R + ss212R; ss212R = (sy211R - -0.85 * sy212R) * keep;
sy213R = -0.85 * sy212R + ss213R; ss213R = (sy212R - -0.85 * sy213R) * keep;
sy214R = -0.85 * sy213R + ss214R; ss214R = (sy213R - -0.85 * sy214R) * keep;
sy215R = -0.85 * sy214R + ss215R; ss215R = (sy214R - -0.85 * sy215R) * keep;
sy216R = -0.85 * sy215R + ss216R; ss216R = (sy215R - -0.85 * sy216R) * keep;
sy217R = -0.85 * sy216R + ss217R; ss217R = (sy216R - -0.85 * sy217R) * keep;
sy218R = -0.85 * sy217R + ss218R; ss218R = (sy217R - -0.85 * sy218R) * keep;
sy219R = -0.85 * sy218R + ss219R; ss219R = (sy218R - -0.85 * sy219R) * keep;
sy220R = -0.85 * sy219R + ss220R; ss220R = (sy219R - -0.85 * sy220R) * keep;
sy221R = -0.85 * sy220R + ss221R; ss221R = (sy220R - -0.85 * sy221R) * keep;
sy222R = -0.85 * sy221R + ss222R; ss222R = (sy221R - -0.85 * sy222R) * keep;
sy223R = -0.85 * sy222R + ss223R; ss223R = (sy222R - -0.85 * sy223R) * keep;
poke(sd2R, sy223R * keep, sw2R); sw2R = mod(sw2R + 1, 16384);
fxsR = (sr1R * snr1 + sr2R * snr2) * 0.7071;
// bitcrusher: quantise to fbq bits (level dependent: a quiet signal is crushed harder), then sample & hold every bfac samples
fqzR = floor(fxnR * bqv + 0.5) / (bqv * drv);
bphR = bphR + 1 / bfac; btkR = bphR >= 1; bphR = bphR - btkR;
bhdR = (bhdR + btkR * (fqzR - bhdR)) * keep;
fxoR = e0 * fxiR + e1 * (fxiR * (1 - fxm) + fxwR * fxm) + e2 * (fxiR * (1 - fxm) + fxsR * fxm) + e3 * (fxiR * (1 - fxm) + bhdR * fxm);
svR = tanh(drv * fxoR) / drv;
// delay type BBD: two more low-pass poles (dark repeats) and a little hiss, written into the loop
bb1R = (bb1R + bba * (svR - bb1R)) * keep;
bb2R = (bb2R + bba * (bb1R - bb2R)) * keep;
swR = svR * (1 - kB) + (bb2R + 0.0003 * noise()) * kB;
swR = swR * (abs(swR) > 0.000000000001);   // flush below 1e-12: nothing infinitesimal can grow back by itself (RESET stays empty)
poke(dbR, swR * keep, wR);
wR = mod(wR + 1, 131072);
xpR = xR;
// output tap = delay output; x <= 1/drive, so wet <= level
yoR = in2 * (1 - wmx) + xR * drv * lvl * wmx;

// stereo width of the whole result (wet + dry): mid/side, 0 = mono, 1 = unchanged
mdd = (yoL + yoR) * 0.5;
sdd = (yoL - yoR) * 0.5;
out1 = mdd + sdd * wdt;
out2 = mdd - sdd * wdt;
