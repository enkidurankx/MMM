// MMM Ring Mod: flexible stereo ring / amplitude modulator.
// Carrier: sine / tri / square (pulse width) / saw (PolyBLEP), wavefolder, fine tune, LFO on pitch, input->carrier FM,
// Ring <-> AM bias, ideal or diode-bridge character, stereo phase spread, drive, output HP/LP, wet/dry.
// Generated by build_ringmod.py - edit there, not here.
// in1/in2 = audio in; out1/out2 = audio out.
Param p_freq(440, min=0.1, max=8000);
Param p_fine(0, min=-100, max=100);
Param p_pw(0.5, min=0.05, max=0.95);
Param p_fold(0, min=0, max=1);
Param p_bias(0, min=0, max=1);
Param p_fm(0, min=0, max=1);
Param p_spread(0, min=0, max=0.5);
Param p_lfor(1, min=0.02, max=30);
Param p_lfod(0, min=0, max=2);
Param p_drive(0, min=0, max=1);
Param p_hp(20, min=20, max=2000);
Param p_lp(20000, min=200, max=20000);
Param p_wet(1, min=0, max=1);
Param p_gain(0, min=-24, max=12);
Param p_wave(0, min=0, max=3);
Param p_mode(0, min=0, max=1);
History ph(0); History lph(0); History lpL(0); History hlL(0); History lpR(0); History hlR(0);

// ---- locals (all initialised) ----
xL = 0; xR = 0; ppL = 0; ppR = 0; dtL = 0; dtR = 0; cL = 0; cR = 0; blL = 0; blR = 0; qL = 0; qR = 0; ceL = 0; ceR = 0; rL = 0; rR = 0; kL = 0; kR = 0; yL = 0; yR = 0; oL = 0; oR = 0; u = 0; m = 0; fhz = 0; lfo = 0; ingain = 1; drv = 0; alp = 0; ahp = 0; og = 1; v = 0; w = 0; dd = 0; dA = 0; dB = 0; t1 = 0; t2 = 0;

ingain = 1 + p_drive * 3;
drv = p_drive;
m = 0.5 * (in1 + in2);
// carrier frequency: Hz * fine tune * LFO (octaves) * input FM (up to +-2 octaves)
lph = lph + p_lfor / samplerate;
lph = lph - floor(lph);
lfo = sin(6.2831853 * lph);
m = max(-1, min(1, m));
fhz = p_freq * pow(2, p_fine / 1200 + lfo * p_lfod + m * p_fm * p_fm * 2);
fhz = max(0.01, min(0.45 * samplerate, fhz));
ph = ph + fhz / samplerate;
ph = ph - floor(ph);
alp = 1 - exp(0 - 6.2831853 * min(0.45 * samplerate, p_lp) / samplerate);
ahp = 1 - exp(0 - 6.2831853 * p_hp / samplerate);
og = pow(10, p_gain / 20);

// ---- channel L
xL = in1 * ingain;
xL = xL + drv * (((exp(2 * max(-20, min(20, xL * 3))) - 1) / (exp(2 * max(-20, min(20, xL * 3))) + 1)) - xL);
ppL = ph;
ppL = ppL - floor(ppL);
dtL = min(0.45, fhz / samplerate);
// carrier
cL = 0;
if (p_wave < 0.5) { cL = sin(6.2831853 * ppL); }
if (p_wave > 0.5) {
  if (p_wave < 1.5) {
    cL = 4 * abs(ppL - 0.5) - 1;
    cL = 0 - cL;
  }
}
if (p_wave > 1.5) {
  if (p_wave < 2.5) {
    cL = 1;
    if (ppL >= p_pw) { cL = -1; }
    blL = 0;
    if (ppL < dtL) { u = ppL / dtL; blL = u + u - u * u - 1; }
    if (ppL > 1 - dtL) { u = (ppL - 1) / dtL; blL = u * u + u + u + 1; }
    cL = cL + blL;
    qL = ppL - p_pw;
    qL = qL - floor(qL);
    blL = 0;
    if (qL < dtL) { u = qL / dtL; blL = u + u - u * u - 1; }
    if (qL > 1 - dtL) { u = (qL - 1) / dtL; blL = u * u + u + u + 1; }
    cL = cL - blL;
  }
}
if (p_wave > 2.5) {
  cL = 2 * ppL - 1;
  blL = 0;
  if (ppL < dtL) { u = ppL / dtL; blL = u + u - u * u - 1; }
  if (ppL > 1 - dtL) { u = (ppL - 1) / dtL; blL = u * u + u + u + 1; }
  cL = cL - blL;
}
// fold (smooth wavefolder) + AM bias
cL = cL + p_fold * (sin(1.5707963 * cL * (1 + p_fold * 5)) - cL);
ceL = cL + p_bias * ((0.5 + 0.5 * cL) - cL);
// modulation
rL = xL * ceL;
if (p_mode > 0.5) {
  kL = cL;
  rL = kL / (abs(kL) + 0.05);
  rL = rL * ((((kL + xL) / (abs(kL + xL) + 0.000001)) * (pow(max(0, min(abs(kL + xL), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kL + xL) - 0.4))) - (((kL - xL) / (abs(kL - xL) + 0.000001)) * (pow(max(0, min(abs(kL - xL), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kL - xL) - 0.4)))) * 0.5;
  rL = rL + p_bias * (xL * ceL - rL);
}
// output filters (one pole HP / LP) + wet/dry + gain
lpL = lpL + (rL - lpL) * alp;
hlL = hlL + (lpL - hlL) * ahp;
yL = lpL - hlL;
oL = (in1 * (1 - p_wet) + yL * p_wet) * og;

// ---- channel R
xR = in2 * ingain;
xR = xR + drv * (((exp(2 * max(-20, min(20, xR * 3))) - 1) / (exp(2 * max(-20, min(20, xR * 3))) + 1)) - xR);
ppR = ph + p_spread;
ppR = ppR - floor(ppR);
dtR = min(0.45, fhz / samplerate);
// carrier
cR = 0;
if (p_wave < 0.5) { cR = sin(6.2831853 * ppR); }
if (p_wave > 0.5) {
  if (p_wave < 1.5) {
    cR = 4 * abs(ppR - 0.5) - 1;
    cR = 0 - cR;
  }
}
if (p_wave > 1.5) {
  if (p_wave < 2.5) {
    cR = 1;
    if (ppR >= p_pw) { cR = -1; }
    blR = 0;
    if (ppR < dtR) { u = ppR / dtR; blR = u + u - u * u - 1; }
    if (ppR > 1 - dtR) { u = (ppR - 1) / dtR; blR = u * u + u + u + 1; }
    cR = cR + blR;
    qR = ppR - p_pw;
    qR = qR - floor(qR);
    blR = 0;
    if (qR < dtR) { u = qR / dtR; blR = u + u - u * u - 1; }
    if (qR > 1 - dtR) { u = (qR - 1) / dtR; blR = u * u + u + u + 1; }
    cR = cR - blR;
  }
}
if (p_wave > 2.5) {
  cR = 2 * ppR - 1;
  blR = 0;
  if (ppR < dtR) { u = ppR / dtR; blR = u + u - u * u - 1; }
  if (ppR > 1 - dtR) { u = (ppR - 1) / dtR; blR = u * u + u + u + 1; }
  cR = cR - blR;
}
// fold (smooth wavefolder) + AM bias
cR = cR + p_fold * (sin(1.5707963 * cR * (1 + p_fold * 5)) - cR);
ceR = cR + p_bias * ((0.5 + 0.5 * cR) - cR);
// modulation
rR = xR * ceR;
if (p_mode > 0.5) {
  kR = cR;
  rR = kR / (abs(kR) + 0.05);
  rR = rR * ((((kR + xR) / (abs(kR + xR) + 0.000001)) * (pow(max(0, min(abs(kR + xR), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kR + xR) - 0.4))) - (((kR - xR) / (abs(kR - xR) + 0.000001)) * (pow(max(0, min(abs(kR - xR), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kR - xR) - 0.4)))) * 0.5;
  rR = rR + p_bias * (xR * ceR - rR);
}
// output filters (one pole HP / LP) + wet/dry + gain
lpR = lpR + (rR - lpR) * alp;
hlR = hlR + (lpR - hlR) * ahp;
yR = lpR - hlR;
oR = (in2 * (1 - p_wet) + yR * p_wet) * og;

out1 = oL; out2 = oR;
