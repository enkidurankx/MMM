              {
                "box": {
                  "id": "obj-3",
                  "maxclass": "codebox",
                  "code": "// MMM Ring Mod: flexible stereo ring / amplitude modulator.\n// Carrier: sine / tri / square (pulse width) / saw (PolyBLEP), wavefolder, fine tune, LFO on pitch, input->carrier FM,\n// Ring <-> AM bias, ideal or diode-bridge character, stereo phase spread, drive, output HP/LP, wet/dry.\n// Generated by build_ringmod.py - edit there, not here.\n// in1/in2 = audio in; out1/out2 = audio out.\nParam p_freq(440, min=0.1, max=8000);\nParam p_fine(0, min=-100, max=100);\nParam p_pw(0.5, min=0.05, max=0.95);\nParam p_fold(0, min=0, max=1);\nParam p_bias(0, min=0, max=1);\nParam p_fm(0, min=0, max=1);\nParam p_spread(0, min=0, max=0.5);\nParam p_lfor(1, min=0.02, max=30);\nParam p_lfod(0, min=0, max=2);\nParam p_drive(0, min=0, max=1);\nParam p_hp(20, min=20, max=2000);\nParam p_lp(20000, min=200, max=20000);\nParam p_wet(1, min=0, max=1);\nParam p_gain(0, min=-24, max=12);\nParam p_wave(0, min=0, max=3);\nParam p_mode(0, min=0, max=1);\nHistory ph(0); History lph(0); History lpL(0); History hlL(0); History lpR(0); History hlR(0);\n\n// ---- locals (all initialised) ----\nxL = 0; xR = 0; ppL = 0; ppR = 0; dtL = 0; dtR = 0; cL = 0; cR = 0; blL = 0; blR = 0; qL = 0; qR = 0; ceL = 0; ceR = 0; rL = 0; rR = 0; kL = 0; kR = 0; yL = 0; yR = 0; oL = 0; oR = 0; u = 0; m = 0; fhz = 0; lfo = 0; ingain = 1; drv = 0; alp = 0; ahp = 0; og = 1; v = 0; w = 0; dd = 0; dA = 0; dB = 0; t1 = 0; t2 = 0;\n\ningain = 1 + p_drive * 3;\ndrv = p_drive;\nm = 0.5 * (in1 + in2);\n// carrier frequency: Hz * fine tune * LFO (octaves) * input FM (up to +-2 octaves)\nlph = lph + p_lfor / samplerate;\nlph = lph - floor(lph);\nlfo = sin(6.2831853 * lph);\nm = max(-1, min(1, m));\nfhz = p_freq * pow(2, p_fine / 1200 + lfo * p_lfod + m * p_fm * p_fm * 2);\nfhz = max(0.01, min(0.45 * samplerate, fhz));\nph = ph + fhz / samplerate;\nph = ph - floor(ph);\nalp = 1 - exp(0 - 6.2831853 * min(0.45 * samplerate, p_lp) / samplerate);\nahp = 1 - exp(0 - 6.2831853 * p_hp / samplerate);\nog = pow(10, p_gain / 20);\n\n// ---- channel L\nxL = in1 * ingain;\nxL = xL + drv * (((exp(2 * max(-20, min(20, xL * 3))) - 1) / (exp(2 * max(-20, min(20, xL * 3))) + 1)) - xL);\nppL = ph;\nppL = ppL - floor(ppL);\ndtL = min(0.45, fhz / samplerate);\n// carrier\ncL = 0;\nif (p_wave < 0.5) { cL = sin(6.2831853 * ppL); }\nif (p_wave > 0.5) {\n  if (p_wave < 1.5) {\n    cL = 4 * abs(ppL - 0.5) - 1;\n    cL = 0 - cL;\n  }\n}\nif (p_wave > 1.5) {\n  if (p_wave < 2.5) {\n    cL = 1;\n    if (ppL >= p_pw) { cL = -1; }\n    blL = 0;\n    if (ppL < dtL) { u = ppL / dtL; blL = u + u - u * u - 1; }\n    if (ppL > 1 - dtL) { u = (ppL - 1) / dtL; blL = u * u + u + u + 1; }\n    cL = cL + blL;\n    qL = ppL - p_pw;\n    qL = qL - floor(qL);\n    blL = 0;\n    if (qL < dtL) { u = qL / dtL; blL = u + u - u * u - 1; }\n    if (qL > 1 - dtL) { u = (qL - 1) / dtL; blL = u * u + u + u + 1; }\n    cL = cL - blL;\n  }\n}\nif (p_wave > 2.5) {\n  cL = 2 * ppL - 1;\n  blL = 0;\n  if (ppL < dtL) { u = ppL / dtL; blL = u + u - u * u - 1; }\n  if (ppL > 1 - dtL) { u = (ppL - 1) / dtL; blL = u * u + u + u + 1; }\n  cL = cL - blL;\n}\n// fold (smooth wavefolder) + AM bias\ncL = cL + p_fold * (sin(1.5707963 * cL * (1 + p_fold * 5)) - cL);\nceL = cL + p_bias * ((0.5 + 0.5 * cL) - cL);\n// modulation\nrL = xL * ceL;\nif (p_mode > 0.5) {\n  kL = cL;\n  rL = kL / (abs(kL) + 0.05);\n  rL = rL * ((((kL + xL) / (abs(kL + xL) + 0.000001)) * (pow(max(0, min(abs(kL + xL), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kL + xL) - 0.4))) - (((kL - xL) / (abs(kL - xL) + 0.000001)) * (pow(max(0, min(abs(kL - xL), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kL - xL) - 0.4)))) * 0.5;\n  rL = rL + p_bias * (xL * ceL - rL);\n}\n// output filters (one pole HP / LP) + wet/dry + gain\nlpL = lpL + (rL - lpL) * alp;\nhlL = hlL + (lpL - hlL) * ahp;\nyL = lpL - hlL;\noL = (in1 * (1 - p_wet) + yL * p_wet) * og;\n\n// ---- channel R\nxR = in2 * ingain;\nxR = xR + drv * (((exp(2 * max(-20, min(20, xR * 3))) - 1) / (exp(2 * max(-20, min(20, xR * 3))) + 1)) - xR);\nppR = ph + p_spread;\nppR = ppR - floor(ppR);\ndtR = min(0.45, fhz / samplerate);\n// carrier\ncR = 0;\nif (p_wave < 0.5) { cR = sin(6.2831853 * ppR); }\nif (p_wave > 0.5) {\n  if (p_wave < 1.5) {\n    cR = 4 * abs(ppR - 0.5) - 1;\n    cR = 0 - cR;\n  }\n}\nif (p_wave > 1.5) {\n  if (p_wave < 2.5) {\n    cR = 1;\n    if (ppR >= p_pw) { cR = -1; }\n    blR = 0;\n    if (ppR < dtR) { u = ppR / dtR; blR = u + u - u * u - 1; }\n    if (ppR > 1 - dtR) { u = (ppR - 1) / dtR; blR = u * u + u + u + 1; }\n    cR = cR + blR;\n    qR = ppR - p_pw;\n    qR = qR - floor(qR);\n    blR = 0;\n    if (qR < dtR) { u = qR / dtR; blR = u + u - u * u - 1; }\n    if (qR > 1 - dtR) { u = (qR - 1) / dtR; blR = u * u + u + u + 1; }\n    cR = cR - blR;\n  }\n}\nif (p_wave > 2.5) {\n  cR = 2 * ppR - 1;\n  blR = 0;\n  if (ppR < dtR) { u = ppR / dtR; blR = u + u - u * u - 1; }\n  if (ppR > 1 - dtR) { u = (ppR - 1) / dtR; blR = u * u + u + u + 1; }\n  cR = cR - blR;\n}\n// fold (smooth wavefolder) + AM bias\ncR = cR + p_fold * (sin(1.5707963 * cR * (1 + p_fold * 5)) - cR);\nceR = cR + p_bias * ((0.5 + 0.5 * cR) - cR);\n// modulation\nrR = xR * ceR;\nif (p_mode > 0.5) {\n  kR = cR;\n  rR = kR / (abs(kR) + 0.05);\n  rR = rR * ((((kR + xR) / (abs(kR + xR) + 0.000001)) * (pow(max(0, min(abs(kR + xR), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kR + xR) - 0.4))) - (((kR - xR) / (abs(kR - xR) + 0.000001)) * (pow(max(0, min(abs(kR - xR), 0.4) - 0.2), 2) / 0.4 + max(0, abs(kR - xR) - 0.4)))) * 0.5;\n  rR = rR + p_bias * (xR * ceR - rR);\n}\n// output filters (one pole HP / LP) + wet/dry + gain\nlpR = lpR + (rR - lpR) * alp;\nhlR = hlR + (lpR - hlR) * ahp;\nyR = lpR - hlR;\noR = (in2 * (1 - p_wet) + yR * p_wet) * og;\n\nout1 = oL; out2 = oR;",
                  "numinlets": 2,
                  "numoutlets": 2,
                  "outlettype": [
                    "",
                    ""
                  ],
                  "patching_rect": [
