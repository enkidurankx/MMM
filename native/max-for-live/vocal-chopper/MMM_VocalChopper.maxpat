              {
                "box": {
                  "id": "obj-3",
                  "maxclass": "codebox",
                  "code": "// MMM Vocal Chopper engine: rolling record buffer -> grain pool -> 4 stereo voices.\n// Generated by build_chopper.py - edit there, not here.\n// in1/in2 = live input; out1..out8 = voice1 L/R, voice2 L/R, voice3 L/R, voice4 L/R (dry is added to voice 1).\n// Counters p_tick / p_fire / p_panic: any change = one event (set by Max, no sample-accurate clock needed).\nParam p_chaos(0.5, min=0, max=1);\nParam p_size(150, min=10, max=2000);\nParam p_prob(1, min=0, max=1);\nParam p_thr(-30, min=-60, max=0);\nParam p_dry(0, min=0, max=1);\nParam p_range(0.6, min=0.02, max=1);\nParam p_pitch(7, min=0, max=24);\nParam p_rev(0.3, min=0, max=1);\nParam p_rept(1, min=1, max=8);\nParam p_width(0.6, min=0, max=1);\nParam p_fade(5, min=1, max=100);\nParam p_lvlvar(0.5, min=0, max=1);\nParam p_bufsec(4, min=0.5, max=8);\nParam p_sens(2, min=1.2, max=6);\nParam p_gap(60, min=10, max=500);\nParam p_lfor(2, min=0.05, max=20);\nParam p_lfoslew(50, min=0, max=2000);\nParam p_lfodepth(0.5, min=0, max=1);\nParam p_hold(0, min=0, max=1);\nParam p_trigmode(0, min=0, max=2);      // 0 clock, 1 onset, 2 both\nParam p_outs(4, min=1, max=4);\nParam p_route(0, min=0, max=3);         // 0 random, 1 cycle, 2 by level, 3 by pitch\nParam p_tick(0, min=0, max=1000000000);\nParam p_fire(0, min=0, max=1000000000);\nParam p_panic(0, min=0, max=1000000000);\nParam p_lfo(0, min=0, max=1);\nParam p_lfotick(0, min=0, max=1);       // 1 = new S&H values on every chop step instead of the LFO clock\nParam p_tsize(1, min=0, max=1);\nParam p_tpitch(1, min=0, max=1);\nParam p_trev(1, min=0, max=1);\nParam p_tprob(0, min=0, max=1);\nParam p_trange(0, min=0, max=1);\nParam p_twidth(0, min=0, max=1);\nParam p_trept(0, min=0, max=1);\nParam p_tchaos(0, min=0, max=1);\nData bufL(768000); Data bufR(768000);\nHistory wr(0); History ef(0); History es(0); History gapc(0);\nHistory prevtick(0); History prevfire(0); History prevpanic(0);\nHistory repleft(0); History repcnt(0); History rr(0);\nHistory lph(0);\nHistory s_dur(1000); History s_start(0); History s_inc(1); History s_lg(1); History s_rg(1); History s_voice(0); History s_fade(100);\nHistory sh1(0); History l1(0);\nHistory sh2(0); History l2(0);\nHistory sh3(0); History l3(0);\nHistory sh4(0); History l4(0);\nHistory sh5(0); History l5(0);\nHistory sh6(0); History l6(0);\nHistory sh7(0); History l7(0);\nHistory sh8(0); History l8(0);\nHistory g0act(0); History g0pos(0); History g0inc(1); History g0age(0); History g0len(1000); History g0fade(100); History g0lg(1); History g0rg(1); History g0v(0);\nHistory g1act(0); History g1pos(0); History g1inc(1); History g1age(0); History g1len(1000); History g1fade(100); History g1lg(1); History g1rg(1); History g1v(0);\nHistory g2act(0); History g2pos(0); History g2inc(1); History g2age(0); History g2len(1000); History g2fade(100); History g2lg(1); History g2rg(1); History g2v(0);\nHistory g3act(0); History g3pos(0); History g3inc(1); History g3age(0); History g3len(1000); History g3fade(100); History g3lg(1); History g3rg(1); History g3v(0);\nHistory g4act(0); History g4pos(0); History g4inc(1); History g4age(0); History g4len(1000); History g4fade(100); History g4lg(1); History g4rg(1); History g4v(0);\nHistory g5act(0); History g5pos(0); History g5inc(1); History g5age(0); History g5len(1000); History g5fade(100); History g5lg(1); History g5rg(1); History g5v(0);\nHistory g6act(0); History g6pos(0); History g6inc(1); History g6age(0); History g6len(1000); History g6fade(100); History g6lg(1); History g6rg(1); History g6v(0);\nHistory g7act(0); History g7pos(0); History g7inc(1); History g7age(0); History g7len(1000); History g7fade(100); History g7lg(1); History g7rg(1); History g7v(0);\n\n// ---- locals (all initialised) ----\ninL = 0; inR = 0; m = 0; bl = 0; hd = 0; a = 0; ca = 0; cr = 0; cs = 0; thrl = 0; onset = 0; tk = 0; fi = 0; pn = 0; clkon = 0; lt = 0; lclk = 0; tau = 0; lf = 0; ev = 0; newg = 0; r = 0; sz = 0; dur = 0; semi = 0; inc = 0; dr = 0; span = 0; maxback = 0; bk = 0; far = 0; lv = 0; pn2 = 0; ang = 0; nv = 0; v = 0; u = 0; uu = 0; db = 0; pr = 0; slot = 0; best = 0; rm = 0; fd = 0; ee = 0; eo = 0; pw = 0; i0 = 0; i1 = 0; fr = 0; sa = 0; sb = 0; gl = 0; gr = 0; vv = 0; dry = 0; size_e = 0; pitch_e = 0; rev_e = 0; prob_e = 0; range_e = 0; width_e = 0; rept_e = 0; chaos_e = 0; o1 = 0; o2 = 0; o3 = 0; o4 = 0; o5 = 0; o6 = 0; o7 = 0; o8 = 0;\n\ninL = in1; inR = in2;\nm = 0.5 * (inL + inR);\nbl = floor(min(768000, max(1000, p_bufsec * samplerate)));\ndry = max(0, min(1, p_dry));\n\n// ---- record (hold = freeze the buffer) ----\nhd = p_hold;\nif (hd < 0.5) {\n    poke(bufL, inL, wr);\n    poke(bufR, inR, wr);\n    wr = wr + 1;\n    if (wr >= bl) { wr = 0; }\n}\nif (wr >= bl) { wr = 0; }\n\n// ---- onset detector: fast envelope vs slow envelope, threshold + refractory gap ----\na = abs(m);\nca = 1 - exp(-1 / (0.001 * samplerate));\ncr = 1 - exp(-1 / (0.03 * samplerate));\ncs = 1 - exp(-1 / (0.25 * samplerate));\nif (a > ef) { ef = ef + (a - ef) * ca; }\nif (a <= ef) { ef = ef + (a - ef) * cr; }\nes = es + (a - es) * cs;\nthrl = pow(10, p_thr / 20);\nif (gapc > 0) { gapc = gapc - 1; }\nonset = 0;\nif (p_trigmode > 0.5) {\n    if (ef > thrl) {\n        if (ef > es * p_sens) {\n            if (gapc <= 0) { onset = 1; gapc = p_gap * 0.001 * samplerate; }\n        }\n    }\n}\n\n// ---- counters from Max ----\ntk = 0; if (p_tick != prevtick) { tk = 1; } prevtick = p_tick;\nfi = 0; if (p_fire != prevfire) { fi = 1; } prevfire = p_fire;\npn = 0; if (p_panic != prevpanic) { pn = 1; } prevpanic = p_panic;\nclkon = 1;\nif (p_trigmode > 0.5) { if (p_trigmode < 1.5) { clkon = 0; } }\n\n// ---- sample & hold LFO: 8 independent values, smoothed by Slew ----\nlph = lph + max(0.05, p_lfor) / samplerate;\nlt = 0;\nif (lph >= 1) { lph = lph - 1; lt = 1; }\nlclk = lt;\nif (p_lfotick > 0.5) { lclk = tk; }\nif (lclk > 0.5) {\n    sh1 = noise(); sh2 = noise(); sh3 = noise(); sh4 = noise(); sh5 = noise(); sh6 = noise(); sh7 = noise(); sh8 = noise();\n}\ntau = max(1, p_lfoslew * 0.001 * samplerate);\nl1 = l1 + (sh1 - l1) / tau; l2 = l2 + (sh2 - l2) / tau; l3 = l3 + (sh3 - l3) / tau; l4 = l4 + (sh4 - l4) / tau;\nl5 = l5 + (sh5 - l5) / tau; l6 = l6 + (sh6 - l6) / tau; l7 = l7 + (sh7 - l7) / tau; l8 = l8 + (sh8 - l8) / tau;\nlf = 0;\nif (p_lfo > 0.5) { lf = max(0, min(1, p_lfodepth)); }\n\n// ---- event: clock tick, onset or Fire button ----\nev = fi;\nif (onset > 0.5) { ev = 1; }\nif (tk > 0.5) { if (clkon > 0.5) { ev = 1; } }\nnewg = 0;\nif (ev > 0.5) {\n    size_e = p_size * pow(2, lf * p_tsize * l1 * 2);\n    pitch_e = min(24, max(0, p_pitch + lf * p_tpitch * l2 * 12));\n    rev_e = min(1, max(0, p_rev + lf * p_trev * l3 * 0.5));\n    prob_e = min(1, max(0, p_prob + lf * p_tprob * l4 * 0.5));\n    range_e = min(1, max(0.02, p_range + lf * p_trange * l5 * 0.5));\n    width_e = min(1, max(0, p_width + lf * p_twidth * l6 * 0.5));\n    rept_e = min(8, max(1, p_rept + lf * p_trept * l7 * 3));\n    chaos_e = min(1, max(0, p_chaos + lf * p_tchaos * l8 * 0.5));\n    r = (noise() + 1) * 0.5;\n    if (fi > 0.5) { r = 0; }\n    if (r <= prob_e) {\n        // length: Size, spread by Chaos (up to +-1.5 octaves)\n        sz = size_e * pow(2, noise() * chaos_e * 1.5);\n        sz = max(10, min(3000, sz));\n        dur = sz * 0.001 * samplerate;\n        // pitch scatter in whole semitones, reverse\n        semi = floor(noise() * pitch_e * chaos_e + 0.5);\n        inc = pow(2, semi / 12);\n        dr = 1;\n        u = (noise() + 1) * 0.5;\n        if (u < rev_e * chaos_e) { dr = -1; }\n        dur = min(dur, (bl - 2000) / inc);\n        span = dur * inc;\n        // position: somewhere inside the last Range * buffer, never past the write head\n        maxback = max(0, range_e * bl - span);\n        bk = (noise() + 1) * 0.5 * maxback;\n        far = bk + span;\n        s_start = wr - far;\n        if (dr < 0) { s_start = wr - bk; }\n        s_inc = inc * dr;\n        s_dur = dur;\n        s_fade = max(8, min(dur * 0.5, p_fade * 0.001 * samplerate));\n        // level + pan (equal power)\n        lv = 1 - (noise() + 1) * 0.5 * p_lvlvar * chaos_e;\n        pn2 = noise() * width_e;\n        ang = (pn2 * 0.5 + 0.5) * 1.5707963;\n        s_lg = cos(ang) * 1.41421 * lv;\n        s_rg = sin(ang) * 1.41421 * lv;\n        // which of the 4 outs\n        nv = max(1, min(4, floor(p_outs + 0.5)));\n        v = 0;\n        u = (noise() + 1) * 0.5;\n        if (p_route < 0.5) { v = floor(u * nv); }\n        if (p_route >= 0.5) { if (p_route < 1.5) { rr = rr + 1; if (rr >= nv) { rr = 0; } v = rr; } }\n        if (p_route >= 1.5) {\n            if (p_route < 2.5) {\n                db = 20 * log(ef + 0.000001) / 2.302585;\n                uu = max(0, min(0.999, (db + 50) / 45));\n                v = floor(uu * nv);\n            }\n        }\n        if (p_route >= 2.5) {\n            pr = max(1, pitch_e * chaos_e);\n            uu = max(0, min(0.999, (semi / pr) * 0.5 + 0.5));\n            v = floor(uu * nv);\n        }\n        s_voice = min(v, nv - 1);\n        repleft = floor(rept_e + 0.5) - 1;\n        repcnt = dur;\n        newg = 1;\n    }\n}\n// repeats (stutter): same slice again, back to back\nif (newg < 0.5) {\n    if (repleft > 0.5) {\n        repcnt = repcnt - 1;\n        if (repcnt <= 0) { newg = 1; repleft = repleft - 1; repcnt = s_dur; }\n    }\n}\n\n// ---- panic: stop everything ----\nif (pn > 0.5) {\n    repleft = 0; newg = 0;\n    g0act = 0;\n    g1act = 0;\n    g2act = 0;\n    g3act = 0;\n    g4act = 0;\n    g5act = 0;\n    g6act = 0;\n    g7act = 0;\n}\n\n// ---- allocate a grain: lowest free slot, else steal the one closest to its end ----\nif (newg > 0.5) {\n    slot = -1;\n    if (g7act < 0.5) { slot = 7; }\n    if (g6act < 0.5) { slot = 6; }\n    if (g5act < 0.5) { slot = 5; }\n    if (g4act < 0.5) { slot = 4; }\n    if (g3act < 0.5) { slot = 3; }\n    if (g2act < 0.5) { slot = 2; }\n    if (g1act < 0.5) { slot = 1; }\n    if (g0act < 0.5) { slot = 0; }\n    if (slot < 0) {\n        best = 1000000000;\n        rm = g0len - g0age; if (rm < best) { best = rm; slot = 0; }\n        rm = g1len - g1age; if (rm < best) { best = rm; slot = 1; }\n        rm = g2len - g2age; if (rm < best) { best = rm; slot = 2; }\n        rm = g3len - g3age; if (rm < best) { best = rm; slot = 3; }\n        rm = g4len - g4age; if (rm < best) { best = rm; slot = 4; }\n        rm = g5len - g5age; if (rm < best) { best = rm; slot = 5; }\n        rm = g6len - g6age; if (rm < best) { best = rm; slot = 6; }\n        rm = g7len - g7age; if (rm < best) { best = rm; slot = 7; }\n    }\n    if (slot == 0) { g0pos = s_start; g0inc = s_inc; g0age = 0; g0len = s_dur; g0fade = s_fade; g0lg = s_lg; g0rg = s_rg; g0v = s_voice; g0act = 1; }\n    if (slot == 1) { g1pos = s_start; g1inc = s_inc; g1age = 0; g1len = s_dur; g1fade = s_fade; g1lg = s_lg; g1rg = s_rg; g1v = s_voice; g1act = 1; }\n    if (slot == 2) { g2pos = s_start; g2inc = s_inc; g2age = 0; g2len = s_dur; g2fade = s_fade; g2lg = s_lg; g2rg = s_rg; g2v = s_voice; g2act = 1; }\n    if (slot == 3) { g3pos = s_start; g3inc = s_inc; g3age = 0; g3len = s_dur; g3fade = s_fade; g3lg = s_lg; g3rg = s_rg; g3v = s_voice; g3act = 1; }\n    if (slot == 4) { g4pos = s_start; g4inc = s_inc; g4age = 0; g4len = s_dur; g4fade = s_fade; g4lg = s_lg; g4rg = s_rg; g4v = s_voice; g4act = 1; }\n    if (slot == 5) { g5pos = s_start; g5inc = s_inc; g5age = 0; g5len = s_dur; g5fade = s_fade; g5lg = s_lg; g5rg = s_rg; g5v = s_voice; g5act = 1; }\n    if (slot == 6) { g6pos = s_start; g6inc = s_inc; g6age = 0; g6len = s_dur; g6fade = s_fade; g6lg = s_lg; g6rg = s_rg; g6v = s_voice; g6act = 1; }\n    if (slot == 7) { g7pos = s_start; g7inc = s_inc; g7age = 0; g7len = s_dur; g7fade = s_fade; g7lg = s_lg; g7rg = s_rg; g7v = s_voice; g7act = 1; }\n}\n\n// ---- grains: linear interpolation, smoothstep fade in/out ----\nif (g0act > 0.5) {\n    fd = g0fade;\n    ee = g0age / fd; if (ee > 1) { ee = 1; }\n    eo = (g0len - g0age) / fd; if (eo > 1) { eo = 1; }\n    if (eo < ee) { ee = eo; }\n    if (ee < 0) { ee = 0; }\n    ee = ee * ee * (3 - 2 * ee);\n    pw = g0pos; pw = pw - bl * floor(pw / bl);\n    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }\n    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;\n    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;\n    gl = sa * ee * g0lg; gr = sb * ee * g0rg;\n    vv = g0v;\n    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }\n    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }\n    if (vv > 1.5) { if (vv < 2.5) { o5 = o5 + gl; o6 = o6 + gr; } }\n    if (vv > 2.5) { o7 = o7 + gl; o8 = o8 + gr; }\n    g0pos = g0pos + g0inc;\n    g0age = g0age + 1;\n    if (g0age >= g0len) { g0act = 0; }\n}\nif (g1act > 0.5) {\n    fd = g1fade;\n    ee = g1age / fd; if (ee > 1) { ee = 1; }\n    eo = (g1len - g1age) / fd; if (eo > 1) { eo = 1; }\n    if (eo < ee) { ee = eo; }\n    if (ee < 0) { ee = 0; }\n    ee = ee * ee * (3 - 2 * ee);\n    pw = g1pos; pw = pw - bl * floor(pw / bl);\n    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }\n    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;\n    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;\n    gl = sa * ee * g1lg; gr = sb * ee * g1rg;\n    vv = g1v;\n    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }\n    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }\n    if (vv > 1.5) { if (vv < 2.5) { o5 = o5 + gl; o6 = o6 + gr; } }\n    if (vv > 2.5) { o7 = o7 + gl; o8 = o8 + gr; }\n    g1pos = g1pos + g1inc;\n    g1age = g1age + 1;\n    if (g1age >= g1len) { g1act = 0; }\n}\nif (g2act > 0.5) {\n    fd = g2fade;\n    ee = g2age / fd; if (ee > 1) { ee = 1; }\n    eo = (g2len - g2age) / fd; if (eo > 1) { eo = 1; }\n    if (eo < ee) { ee = eo; }\n    if (ee < 0) { ee = 0; }\n    ee = ee * ee * (3 - 2 * ee);\n    pw = g2pos; pw = pw - bl * floor(pw / bl);\n    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }\n