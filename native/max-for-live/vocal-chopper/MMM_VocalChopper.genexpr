// MMM Vocal Chopper engine: rolling record buffer -> grain pool -> 4 stereo voices.
// Generated by build_chopper.py - edit there, not here.
// in1/in2 = live input; out1..out8 = voice1 L/R, voice2 L/R, voice3 L/R, voice4 L/R (dry is added to voice 1).
// Counters p_tick / p_fire / p_panic: any change = one event (set by Max, no sample-accurate clock needed).
Param p_chaos(0.5, min=0, max=1);
Param p_size(150, min=10, max=2000);
Param p_prob(1, min=0, max=1);
Param p_thr(-30, min=-60, max=0);
Param p_dry(0, min=0, max=1);
Param p_range(0.6, min=0.02, max=1);
Param p_pitch(7, min=0, max=24);
Param p_rev(0.3, min=0, max=1);
Param p_rept(1, min=1, max=8);
Param p_width(0.6, min=0, max=1);
Param p_fade(5, min=1, max=100);
Param p_lvlvar(0.5, min=0, max=1);
Param p_bufsec(4, min=0.5, max=8);
Param p_sens(2, min=1.2, max=6);
Param p_gap(60, min=10, max=500);
Param p_lfor(2, min=0.05, max=20);
Param p_lfoslew(50, min=0, max=2000);
Param p_lfodepth(0.5, min=0, max=1);
Param p_hold(0, min=0, max=1);
Param p_trigmode(0, min=0, max=2);      // 0 clock, 1 onset, 2 both
Param p_outs(4, min=1, max=4);
Param p_route(0, min=0, max=3);         // 0 random, 1 cycle, 2 by level, 3 by pitch
Param p_tick(0, min=0, max=1000000000);
Param p_fire(0, min=0, max=1000000000);
Param p_panic(0, min=0, max=1000000000);
Param p_lfo(0, min=0, max=1);
Param p_lfotick(0, min=0, max=1);       // 1 = new S&H values on every chop step instead of the LFO clock
Param p_tsize(1, min=0, max=1);
Param p_tpitch(1, min=0, max=1);
Param p_trev(1, min=0, max=1);
Param p_tprob(0, min=0, max=1);
Param p_trange(0, min=0, max=1);
Param p_twidth(0, min=0, max=1);
Param p_trept(0, min=0, max=1);
Param p_tchaos(0, min=0, max=1);
Data bufL(768000); Data bufR(768000);
History wr(0); History ef(0); History es(0); History gapc(0);
History prevtick(0); History prevfire(0); History prevpanic(0);
History repleft(0); History repcnt(0); History rr(0);
History lph(0);
History s_dur(1000); History s_start(0); History s_inc(1); History s_lg(1); History s_rg(1); History s_voice(0); History s_fade(100);
History sh1(0); History l1(0);
History sh2(0); History l2(0);
History sh3(0); History l3(0);
History sh4(0); History l4(0);
History sh5(0); History l5(0);
History sh6(0); History l6(0);
History sh7(0); History l7(0);
History sh8(0); History l8(0);
History g0act(0); History g0pos(0); History g0inc(1); History g0age(0); History g0len(1000); History g0fade(100); History g0lg(1); History g0rg(1); History g0v(0);
History g1act(0); History g1pos(0); History g1inc(1); History g1age(0); History g1len(1000); History g1fade(100); History g1lg(1); History g1rg(1); History g1v(0);
History g2act(0); History g2pos(0); History g2inc(1); History g2age(0); History g2len(1000); History g2fade(100); History g2lg(1); History g2rg(1); History g2v(0);
History g3act(0); History g3pos(0); History g3inc(1); History g3age(0); History g3len(1000); History g3fade(100); History g3lg(1); History g3rg(1); History g3v(0);
History g4act(0); History g4pos(0); History g4inc(1); History g4age(0); History g4len(1000); History g4fade(100); History g4lg(1); History g4rg(1); History g4v(0);
History g5act(0); History g5pos(0); History g5inc(1); History g5age(0); History g5len(1000); History g5fade(100); History g5lg(1); History g5rg(1); History g5v(0);
History g6act(0); History g6pos(0); History g6inc(1); History g6age(0); History g6len(1000); History g6fade(100); History g6lg(1); History g6rg(1); History g6v(0);
History g7act(0); History g7pos(0); History g7inc(1); History g7age(0); History g7len(1000); History g7fade(100); History g7lg(1); History g7rg(1); History g7v(0);

// ---- locals (all initialised) ----
inL = 0; inR = 0; m = 0; bl = 0; hd = 0; a = 0; ca = 0; cr = 0; cs = 0; thrl = 0; onset = 0; tk = 0; fi = 0; pn = 0; clkon = 0; lt = 0; lclk = 0; tau = 0; lf = 0; ev = 0; newg = 0; r = 0; sz = 0; dur = 0; semi = 0; inc = 0; dr = 0; span = 0; maxback = 0; bk = 0; far = 0; lv = 0; pn2 = 0; ang = 0; nv = 0; v = 0; u = 0; uu = 0; db = 0; pr = 0; slot = 0; best = 0; rm = 0; fd = 0; ee = 0; eo = 0; pw = 0; i0 = 0; i1 = 0; fr = 0; sa = 0; sb = 0; gl = 0; gr = 0; vv = 0; dry = 0; size_e = 0; pitch_e = 0; rev_e = 0; prob_e = 0; range_e = 0; width_e = 0; rept_e = 0; chaos_e = 0; o1 = 0; o2 = 0; o3 = 0; o4 = 0; o5 = 0; o6 = 0; o7 = 0; o8 = 0;

inL = in1; inR = in2;
m = 0.5 * (inL + inR);
bl = floor(min(768000, max(1000, p_bufsec * samplerate)));
dry = max(0, min(1, p_dry));

// ---- record (hold = freeze the buffer) ----
hd = p_hold;
if (hd < 0.5) {
    poke(bufL, inL, wr);
    poke(bufR, inR, wr);
    wr = wr + 1;
    if (wr >= bl) { wr = 0; }
}
if (wr >= bl) { wr = 0; }

// ---- onset detector: fast envelope vs slow envelope, threshold + refractory gap ----
a = abs(m);
ca = 1 - exp(-1 / (0.001 * samplerate));
cr = 1 - exp(-1 / (0.03 * samplerate));
cs = 1 - exp(-1 / (0.25 * samplerate));
if (a > ef) { ef = ef + (a - ef) * ca; }
if (a <= ef) { ef = ef + (a - ef) * cr; }
es = es + (a - es) * cs;
thrl = pow(10, p_thr / 20);
if (gapc > 0) { gapc = gapc - 1; }
onset = 0;
if (p_trigmode > 0.5) {
    if (ef > thrl) {
        if (ef > es * p_sens) {
            if (gapc <= 0) { onset = 1; gapc = p_gap * 0.001 * samplerate; }
        }
    }
}

// ---- counters from Max ----
tk = 0; if (p_tick != prevtick) { tk = 1; } prevtick = p_tick;
fi = 0; if (p_fire != prevfire) { fi = 1; } prevfire = p_fire;
pn = 0; if (p_panic != prevpanic) { pn = 1; } prevpanic = p_panic;
clkon = 1;
if (p_trigmode > 0.5) { if (p_trigmode < 1.5) { clkon = 0; } }

// ---- sample & hold LFO: 8 independent values, smoothed by Slew ----
lph = lph + max(0.05, p_lfor) / samplerate;
lt = 0;
if (lph >= 1) { lph = lph - 1; lt = 1; }
lclk = lt;
if (p_lfotick > 0.5) { lclk = tk; }
if (lclk > 0.5) {
    sh1 = noise(); sh2 = noise(); sh3 = noise(); sh4 = noise(); sh5 = noise(); sh6 = noise(); sh7 = noise(); sh8 = noise();
}
tau = max(1, p_lfoslew * 0.001 * samplerate);
l1 = l1 + (sh1 - l1) / tau; l2 = l2 + (sh2 - l2) / tau; l3 = l3 + (sh3 - l3) / tau; l4 = l4 + (sh4 - l4) / tau;
l5 = l5 + (sh5 - l5) / tau; l6 = l6 + (sh6 - l6) / tau; l7 = l7 + (sh7 - l7) / tau; l8 = l8 + (sh8 - l8) / tau;
lf = 0;
if (p_lfo > 0.5) { lf = max(0, min(1, p_lfodepth)); }

// ---- event: clock tick, onset or Fire button ----
ev = fi;
if (onset > 0.5) { ev = 1; }
if (tk > 0.5) { if (clkon > 0.5) { ev = 1; } }
newg = 0;
if (ev > 0.5) {
    size_e = p_size * pow(2, lf * p_tsize * l1 * 2);
    pitch_e = min(24, max(0, p_pitch + lf * p_tpitch * l2 * 12));
    rev_e = min(1, max(0, p_rev + lf * p_trev * l3 * 0.5));
    prob_e = min(1, max(0, p_prob + lf * p_tprob * l4 * 0.5));
    range_e = min(1, max(0.02, p_range + lf * p_trange * l5 * 0.5));
    width_e = min(1, max(0, p_width + lf * p_twidth * l6 * 0.5));
    rept_e = min(8, max(1, p_rept + lf * p_trept * l7 * 3));
    chaos_e = min(1, max(0, p_chaos + lf * p_tchaos * l8 * 0.5));
    r = (noise() + 1) * 0.5;
    if (fi > 0.5) { r = 0; }
    if (r <= prob_e) {
        // length: Size, spread by Chaos (up to +-1.5 octaves)
        sz = size_e * pow(2, noise() * chaos_e * 1.5);
        sz = max(10, min(3000, sz));
        dur = sz * 0.001 * samplerate;
        // pitch scatter in whole semitones, reverse
        semi = floor(noise() * pitch_e * chaos_e + 0.5);
        inc = pow(2, semi / 12);
        dr = 1;
        u = (noise() + 1) * 0.5;
        if (u < rev_e * chaos_e) { dr = -1; }
        dur = min(dur, (bl - 2000) / inc);
        span = dur * inc;
        // position: somewhere inside the last Range * buffer, never past the write head
        maxback = max(0, range_e * bl - span);
        bk = (noise() + 1) * 0.5 * maxback;
        far = bk + span;
        s_start = wr - far;
        if (dr < 0) { s_start = wr - bk; }
        s_inc = inc * dr;
        s_dur = dur;
        s_fade = max(8, min(dur * 0.5, p_fade * 0.001 * samplerate));
        // level + pan (equal power)
        lv = 1 - (noise() + 1) * 0.5 * p_lvlvar * chaos_e;
        pn2 = noise() * width_e;
        ang = (pn2 * 0.5 + 0.5) * 1.5707963;
        s_lg = cos(ang) * 1.41421 * lv;
        s_rg = sin(ang) * 1.41421 * lv;
        // which of the 4 outs
        nv = max(1, min(4, floor(p_outs + 0.5)));
        v = 0;
        u = (noise() + 1) * 0.5;
        if (p_route < 0.5) { v = floor(u * nv); }
        if (p_route >= 0.5) { if (p_route < 1.5) { rr = rr + 1; if (rr >= nv) { rr = 0; } v = rr; } }
        if (p_route >= 1.5) {
            if (p_route < 2.5) {
                db = 20 * log(ef + 0.000001) / 2.302585;
                uu = max(0, min(0.999, (db + 50) / 45));
                v = floor(uu * nv);
            }
        }
        if (p_route >= 2.5) {
            pr = max(1, pitch_e * chaos_e);
            uu = max(0, min(0.999, (semi / pr) * 0.5 + 0.5));
            v = floor(uu * nv);
        }
        s_voice = min(v, nv - 1);
        repleft = floor(rept_e + 0.5) - 1;
        repcnt = dur;
        newg = 1;
    }
}
// repeats (stutter): same slice again, back to back
if (newg < 0.5) {
    if (repleft > 0.5) {
        repcnt = repcnt - 1;
        if (repcnt <= 0) { newg = 1; repleft = repleft - 1; repcnt = s_dur; }
    }
}

// ---- panic: stop everything ----
if (pn > 0.5) {
    repleft = 0; newg = 0;
    g0act = 0;
    g1act = 0;
    g2act = 0;
    g3act = 0;
    g4act = 0;
    g5act = 0;
    g6act = 0;
    g7act = 0;
}

// ---- allocate a grain: lowest free slot, else steal the one closest to its end ----
if (newg > 0.5) {
    slot = -1;
    if (g7act < 0.5) { slot = 7; }
    if (g6act < 0.5) { slot = 6; }
    if (g5act < 0.5) { slot = 5; }
    if (g4act < 0.5) { slot = 4; }
    if (g3act < 0.5) { slot = 3; }
    if (g2act < 0.5) { slot = 2; }
    if (g1act < 0.5) { slot = 1; }
    if (g0act < 0.5) { slot = 0; }
    if (slot < 0) {
        best = 1000000000;
        rm = g0len - g0age; if (rm < best) { best = rm; slot = 0; }
        rm = g1len - g1age; if (rm < best) { best = rm; slot = 1; }
        rm = g2len - g2age; if (rm < best) { best = rm; slot = 2; }
        rm = g3len - g3age; if (rm < best) { best = rm; slot = 3; }
        rm = g4len - g4age; if (rm < best) { best = rm; slot = 4; }
        rm = g5len - g5age; if (rm < best) { best = rm; slot = 5; }
        rm = g6len - g6age; if (rm < best) { best = rm; slot = 6; }
        rm = g7len - g7age; if (rm < best) { best = rm; slot = 7; }
    }
    if (slot == 0) { g0pos = s_start; g0inc = s_inc; g0age = 0; g0len = s_dur; g0fade = s_fade; g0lg = s_lg; g0rg = s_rg; g0v = s_voice; g0act = 1; }
    if (slot == 1) { g1pos = s_start; g1inc = s_inc; g1age = 0; g1len = s_dur; g1fade = s_fade; g1lg = s_lg; g1rg = s_rg; g1v = s_voice; g1act = 1; }
    if (slot == 2) { g2pos = s_start; g2inc = s_inc; g2age = 0; g2len = s_dur; g2fade = s_fade; g2lg = s_lg; g2rg = s_rg; g2v = s_voice; g2act = 1; }
    if (slot == 3) { g3pos = s_start; g3inc = s_inc; g3age = 0; g3len = s_dur; g3fade = s_fade; g3lg = s_lg; g3rg = s_rg; g3v = s_voice; g3act = 1; }
    if (slot == 4) { g4pos = s_start; g4inc = s_inc; g4age = 0; g4len = s_dur; g4fade = s_fade; g4lg = s_lg; g4rg = s_rg; g4v = s_voice; g4act = 1; }
    if (slot == 5) { g5pos = s_start; g5inc = s_inc; g5age = 0; g5len = s_dur; g5fade = s_fade; g5lg = s_lg; g5rg = s_rg; g5v = s_voice; g5act = 1; }
    if (slot == 6) { g6pos = s_start; g6inc = s_inc; g6age = 0; g6len = s_dur; g6fade = s_fade; g6lg = s_lg; g6rg = s_rg; g6v = s_voice; g6act = 1; }
    if (slot == 7) { g7pos = s_start; g7inc = s_inc; g7age = 0; g7len = s_dur; g7fade = s_fade; g7lg = s_lg; g7rg = s_rg; g7v = s_voice; g7act = 1; }
}

// ---- grains: linear interpolation, smoothstep fade in/out ----
if (g0act > 0.5) {
    fd = g0fade;
    ee = g0age / fd; if (ee > 1) { ee = 1; }
    eo = (g0len - g0age) / fd; if (eo > 1) { eo = 1; }
    if (eo < ee) { ee = eo; }
    if (ee < 0) { ee = 0; }
    ee = ee * ee * (3 - 2 * ee);
    pw = g0pos; pw = pw - bl * floor(pw / bl);
    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }
    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;
    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;
    gl = sa * ee * g0lg; gr = sb * ee * g0rg;
    vv = g0v;
    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }
    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }
    if (vv > 1.5) { if (vv < 2.5) { o5 = o5 + gl; o6 = o6 + gr; } }
    if (vv > 2.5) { o7 = o7 + gl; o8 = o8 + gr; }
    g0pos = g0pos + g0inc;
    g0age = g0age + 1;
    if (g0age >= g0len) { g0act = 0; }
}
if (g1act > 0.5) {
    fd = g1fade;
    ee = g1age / fd; if (ee > 1) { ee = 1; }
    eo = (g1len - g1age) / fd; if (eo > 1) { eo = 1; }
    if (eo < ee) { ee = eo; }
    if (ee < 0) { ee = 0; }
    ee = ee * ee * (3 - 2 * ee);
    pw = g1pos; pw = pw - bl * floor(pw / bl);
    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }
    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;
    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;
    gl = sa * ee * g1lg; gr = sb * ee * g1rg;
    vv = g1v;
    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }
    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }
    if (vv > 1.5) { if (vv < 2.5) { o5 = o5 + gl; o6 = o6 + gr; } }
    if (vv > 2.5) { o7 = o7 + gl; o8 = o8 + gr; }
    g1pos = g1pos + g1inc;
    g1age = g1age + 1;
    if (g1age >= g1len) { g1act = 0; }
}
if (g2act > 0.5) {
    fd = g2fade;
    ee = g2age / fd; if (ee > 1) { ee = 1; }
    eo = (g2len - g2age) / fd; if (eo > 1) { eo = 1; }
    if (eo < ee) { ee = eo; }
    if (ee < 0) { ee = 0; }
    ee = ee * ee * (3 - 2 * ee);
    pw = g2pos; pw = pw - bl * floor(pw / bl);
    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }
    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;
    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;
    gl = sa * ee * g2lg; gr = sb * ee * g2rg;
    vv = g2v;
    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }
    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }
    if (vv > 1.5) { if (vv < 2.5) { o5 = o5 + gl; o6 = o6 + gr; } }
    if (vv > 2.5) { o7 = o7 + gl; o8 = o8 + gr; }
    g2pos = g2pos + g2inc;
    g2age = g2age + 1;
    if (g2age >= g2len) { g2act = 0; }
}
if (g3act > 0.5) {
    fd = g3fade;
    ee = g3age / fd; if (ee > 1) { ee = 1; }
    eo = (g3len - g3age) / fd; if (eo > 1) { eo = 1; }
    if (eo < ee) { ee = eo; }
    if (ee < 0) { ee = 0; }
    ee = ee * ee * (3 - 2 * ee);
    pw = g3pos; pw = pw - bl * floor(pw / bl);
    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }
    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;
    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;
    gl = sa * ee * g3lg; gr = sb * ee * g3rg;
    vv = g3v;
    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }
    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }
    if (vv > 1.5) { if (vv < 2.5) { o5 = o5 + gl; o6 = o6 + gr; } }
    if (vv > 2.5) { o7 = o7 + gl; o8 = o8 + gr; }
    g3pos = g3pos + g3inc;
    g3age = g3age + 1;
    if (g3age >= g3len) { g3act = 0; }
}
if (g4act > 0.5) {
    fd = g4fade;
    ee = g4age / fd; if (ee > 1) { ee = 1; }
    eo = (g4len - g4age) / fd; if (eo > 1) { eo = 1; }
    if (eo < ee) { ee = eo; }
    if (ee < 0) { ee = 0; }
    ee = ee * ee * (3 - 2 * ee);
    pw = g4pos; pw = pw - bl * floor(pw / bl);
    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }
    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;
    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;
    gl = sa * ee * g4lg; gr = sb * ee * g4rg;
    vv = g4v;
    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }
    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }
    if (vv > 1.5) { if (vv < 2.5) { o5 = o5 + gl; o6 = o6 + gr; } }
    if (vv > 2.5) { o7 = o7 + gl; o8 = o8 + gr; }
    g4pos = g4pos + g4inc;
    g4age = g4age + 1;
    if (g4age >= g4len) { g4act = 0; }
}
if (g5act > 0.5) {
    fd = g5fade;
    ee = g5age / fd; if (ee > 1) { ee = 1; }
    eo = (g5len - g5age) / fd; if (eo > 1) { eo = 1; }
    if (eo < ee) { ee = eo; }
    if (ee < 0) { ee = 0; }
    ee = ee * ee * (3 - 2 * ee);
    pw = g5pos; pw = pw - bl * floor(pw / bl);
    i0 = floor(pw); fr = pw - i0; i1 = i0 + 1; if (i1 >= bl) { i1 = 0; }
    sa = peek(bufL, i0); sa = sa + (peek(bufL, i1) - sa) * fr;
    sb = peek(bufR, i0); sb = sb + (peek(bufR, i1) - sb) * fr;
    gl = sa * ee * g5lg; gr = sb * ee * g5rg;
    vv = g5v;
    if (vv < 0.5) { o1 = o1 + gl; o2 = o2 + gr; }
    if (vv > 0.5) { if (vv < 1.5) { o3 = o3 + gl; o4 = o4 + gr; } }
