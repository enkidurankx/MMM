// AGE12 real-time: stereo streaming port of the AGE12 sample-ager chain.
// Generated by build_device.py - edit there, not here.
// Latency: 6 samples (dry path is delayed to match).
Param pitchst(12, min=0, max=24);        // semitones up before the crush
Param crushrate(26040, min=4000, max=44100);
Param bitdepth(12, min=4, max=16);
Param prefilt(0, min=0, max=1);
Param companded(0, min=0, max=1);        // 0 linear (SP-style), 1 companded (MPC-style)
Param dacfreq(11000, min=2000, max=20000);
Param dacres(0.3, min=0, max=1);
Param satur(0.3, min=0, max=1);
Param noiselvl(0.12, min=0, max=1);
Param asymm(0.25, min=0, max=1);
Param wetmix(1, min=0, max=1);

History nL(-1); History kL(0); History kLastL(-1); History ySrcL(0); History outPosL(0); History zL(0);
History s1L(0); History s2L(0); History s3L(0); History s4L(0);
Data xbL(256); Data ybL(1024); Data qbL(256);
History nR(-1); History kR(0); History kLastR(-1); History ySrcR(0); History outPosR(0); History zR(0);
History s1R(0); History s2R(0); History s3R(0); History s4R(0);
Data xbR(256); Data ybR(1024); Data qbR(256);

// ---- parameters, clamped so that unset/zero values can never produce inf or NaN ----
pk = max(0, min(24, pitchst));
cr = max(4000, min(44100, crushrate));
bd = max(4, min(16, floor(bitdepth + 0.5)));
pf = max(0, min(1, prefilt));
cmp = max(0, min(1, companded));
df = max(2000, min(20000, dacfreq));
dres = max(0, min(1, dacres));
sat = max(0, min(1, satur));
nz = max(0, min(1, noiselvl));
asy = max(0, min(1, asymm));
wm = max(0, min(1, wetmix));
// ---- values derived from the parameters ----
r = max(1, pow(2, pk / 12));
rinv = 1 / r;
holdstep = samplerate / cr;
levels = pow(2, bd - 1) - 1;
lnK1 = log(56);
precut = samplerate * 0.45 * (1 - pf) + cr * 0.45 * pf;
prex = exp(-6.283185307179586 * precut / samplerate);
prea = 1 - prex;
fcn = min(0.99, max(0.001, df / (samplerate * 0.5)));
f = fcn * 1.16;
fb = dres * 4 * (1 - 0.15 * f * f);
drive = 1 + sat * 3;
dnorm = tanh(drive);

// ================= channel L =================
a = 0; b = 0; y = 0; h = 0; v = 0; sg = 1; sq = 1; cc = 0; qn = 0; c2 = 0; qv = 0; hs = 0; src = 0;
i0 = 0; i1 = 0; j0 = 0; j1 = 0; fr = 0; va = 0; vb = 0; w = 0; inp = 0; o = 0;
nL = nL + 1;
poke(xbL, in1, mod(nL, 256));

// writer: one pitched-up sample per input sample at most (r >= 1)
i0 = floor(ySrcL);
i1 = i0 + 1;
if (i1 <= nL) {
    a = peek(xbL, mod(i0, 256));
    b = peek(xbL, mod(i1, 256));
    y = a + (b - a) * (ySrcL - i0);
    if (pf > 0) {
        zL = prea * y + prex * zL;
        y = zL;
    }
    poke(ybL, y, mod(kL, 1024));
    h = y;
    if (holdstep > 1) {
        hs = floor(kL / holdstep) * holdstep;
        src = floor(hs + 0.5);
        if (src > kL) { src = kL; }
        h = peek(ybL, mod(src, 1024));
    }
    v = min(1, max(-1, h));
    if (cmp > 0.5) {
        sg = 1;
        if (v < 0) { sg = -1; }
        cc = log(1 + 55 * abs(v)) / lnK1;
        qn = floor(sg * cc * levels + 0.5);
        c2 = abs(qn) / levels;
        sq = 1;
        if (qn < 0) { sq = -1; }
        qv = sq * ((exp(c2 * lnK1) - 1) / 55);
    } else {
        qv = floor(v * levels + 0.5) / levels;
    }
    poke(qbL, qv, mod(kL, 256));
    kLastL = kL;
    kL = kL + 1;
    ySrcL = ySrcL + r;
}

// reader: pitch back down, DAC filter, analog stage
wetL = 0;
if (nL >= 6) {
    j0 = floor(outPosL);
    fr = outPosL - j0;
    j1 = j0 + 1;
    if (j1 > kLastL) {
        j1 = kLastL;
        if (j0 > kLastL) { j0 = kLastL; }
    }
    va = peek(qbL, mod(j0, 256));
    vb = peek(qbL, mod(j1, 256));
    w = va + (vb - va) * fr;
    outPosL = outPosL + rinv;

    inp = tanh(w - fb * s4L);
    s1L = s1L + f * (inp - s1L);
    s2L = s2L + f * (s1L - s2L);
    s3L = s3L + f * (s2L - s3L);
    s4L = s4L + f * (s3L - s4L);
    o = s4L;

    if (o < 0) { o = o * (1 + asy * 0.35); }
    if (sat > 0) { o = tanh(o * drive) / dnorm; }
    if (nz > 0) { o = o + noise() * 0.5 * nz * 0.02; }
    wetL = o;
}
dryL = peek(xbL, mod(max(0, nL - 6), 256));
out1 = dryL * (1 - wm) + wetL * wm;

// ================= channel R =================
a = 0; b = 0; y = 0; h = 0; v = 0; sg = 1; sq = 1; cc = 0; qn = 0; c2 = 0; qv = 0; hs = 0; src = 0;
i0 = 0; i1 = 0; j0 = 0; j1 = 0; fr = 0; va = 0; vb = 0; w = 0; inp = 0; o = 0;
nR = nR + 1;
poke(xbR, in2, mod(nR, 256));

// writer: one pitched-up sample per input sample at most (r >= 1)
i0 = floor(ySrcR);
i1 = i0 + 1;
if (i1 <= nR) {
    a = peek(xbR, mod(i0, 256));
    b = peek(xbR, mod(i1, 256));
    y = a + (b - a) * (ySrcR - i0);
    if (pf > 0) {
        zR = prea * y + prex * zR;
        y = zR;
    }
    poke(ybR, y, mod(kR, 1024));
    h = y;
    if (holdstep > 1) {
        hs = floor(kR / holdstep) * holdstep;
        src = floor(hs + 0.5);
        if (src > kR) { src = kR; }
        h = peek(ybR, mod(src, 1024));
    }
    v = min(1, max(-1, h));
    if (cmp > 0.5) {
        sg = 1;
        if (v < 0) { sg = -1; }
        cc = log(1 + 55 * abs(v)) / lnK1;
        qn = floor(sg * cc * levels + 0.5);
        c2 = abs(qn) / levels;
        sq = 1;
        if (qn < 0) { sq = -1; }
        qv = sq * ((exp(c2 * lnK1) - 1) / 55);
    } else {
        qv = floor(v * levels + 0.5) / levels;
    }
    poke(qbR, qv, mod(kR, 256));
    kLastR = kR;
    kR = kR + 1;
    ySrcR = ySrcR + r;
}

// reader: pitch back down, DAC filter, analog stage
wetR = 0;
if (nR >= 6) {
    j0 = floor(outPosR);
    fr = outPosR - j0;
    j1 = j0 + 1;
    if (j1 > kLastR) {
        j1 = kLastR;
        if (j0 > kLastR) { j0 = kLastR; }
    }
    va = peek(qbR, mod(j0, 256));
    vb = peek(qbR, mod(j1, 256));
    w = va + (vb - va) * fr;
    outPosR = outPosR + rinv;

    inp = tanh(w - fb * s4R);
    s1R = s1R + f * (inp - s1R);
    s2R = s2R + f * (s1R - s2R);
    s3R = s3R + f * (s2R - s3R);
    s4R = s4R + f * (s3R - s4R);
    o = s4R;

    if (o < 0) { o = o * (1 + asy * 0.35); }
    if (sat > 0) { o = tanh(o * drive) / dnorm; }
    if (nz > 0) { o = o + noise() * 0.5 * nz * 0.02; }
    wetR = o;
}
dryR = peek(xbR, mod(max(0, nR - 6), 256));
out2 = dryR * (1 - wm) + wetR * wm;
